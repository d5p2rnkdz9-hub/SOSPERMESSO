---
pagination:
  data: permitsEn
  size: 1
  alias: permit
permalink: "en/permesso-{{ permit.slug }}.html"
layout: layouts/base.liquid
lang: en
eleventyComputed:
  title: "Permit for {{ permit.tipo }}"
  description: "Residence permit for {{ permit.tipo }} - information, requirements, documents and procedures"
eleventyExcludeFromCollections: true
---

  <!-- STICKY HEADER: title + tab badges -->
  <div class="permit-sticky-header" id="permit-tab-bar">
    <div class="container">
      <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 0 0.25rem;">
        <span style="font-size: 1.4rem; line-height: 1;">{{ permit.emoji }}</span>
        <h1 class="page-title" style="font-family: 'Poppins', sans-serif; font-weight: 800; font-size: 1.4rem; margin: 0; line-height: 1.2;">Permit for {{ permit.tipo }}</h1>
      </div>
      {% unless permit.isPlaceholder == true %}
      <div class="permit-tab-badges" style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; padding: 0.5rem 0 0.75rem;">
        <a href="#cose" class="tab-badge" onclick="return scrollToSection('cose')">Info</a>
        {% if permit.primoDocuments.size > 0 %}
        <a href="#primo" class="tab-badge tab-badge-primo" onclick="return scrollToSection('primo')">First Issue</a>
        {% endif %}
        {% if permit.rinnovoDocuments.size > 0 %}
        <a href="#rinnovo" class="tab-badge tab-badge-rinnovo" onclick="return scrollToSection('rinnovo')">Renewal</a>
        {% endif %}
        <a href="#prassi-locali" class="tab-badge tab-badge-prassi" onclick="return scrollToSection('prassi-locali')">📍 Local practices</a>
      </div>
      {% endunless %}
    </div>
  </div>

  {% unless permit.isPlaceholder == true %}
  <script>
  function scrollToSection(id) {
    var el = document.getElementById(id);
    if (!el) return true;
    var stickyHeader = document.getElementById('permit-tab-bar');
    var offset = 20;
    if (stickyHeader) offset += stickyHeader.getBoundingClientRect().height;
    var top = el.getBoundingClientRect().top + window.pageYOffset - offset;
    window.scrollTo({ top: top, behavior: 'smooth' });
    setActiveBadge(id);
    return false;
  }

  function setActiveBadge(id) {
    var badges = document.querySelectorAll('.tab-badge');
    badges.forEach(function(b) { b.classList.remove('active'); });
    var active = document.querySelector('.tab-badge[href="#' + id + '"]');
    if (active) active.classList.add('active');
  }

  // Track scroll position to update active badge
  (function() {
    var sections = ['cose', 'primo', 'rinnovo', 'prassi-locali'];
    var ticking = false;

    function getOffset() {
      var stickyHeader = document.getElementById('permit-tab-bar');
      var off = 40;
      if (stickyHeader) off += stickyHeader.getBoundingClientRect().height;
      return off;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        var offset = getOffset();
        var current = null;
        for (var i = sections.length - 1; i >= 0; i--) {
          var el = document.getElementById(sections[i]);
          if (el && el.getBoundingClientRect().top <= offset) {
            current = sections[i];
            break;
          }
        }
        if (current) setActiveBadge(current);
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Set initial active badge on load
    document.addEventListener('DOMContentLoaded', function() {
      onScroll();
    });
  })();
  </script>
  {% endunless %}

{% if permit.isPlaceholder == true %}
  <!-- PLACEHOLDER PAGE -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <div class="card text-center" style="padding: 3rem;">
        <span style="font-size: 4rem;">{{ permit.emoji }}</span>
        <h2 style="margin: 1rem 0;">Content coming soon</h2>
        <p style="color: var(--gray-medium); max-width: 500px; margin: 0 auto 1.5rem;">
          We are still working on completing the information
          about this residence permit.
        </p>
        <a href="https://form.typeform.com/to/USx16QN3"
           class="btn btn-primary"
           target="_blank"
           rel="noopener noreferrer">
          Help out
        </a>
      </div>
    </div>
  </section>

{% else %}

  <!-- SECTION: WHAT IS IT -->
  <section id="cose" class="section">
    <div class="container" style="max-width: 900px;">
      {% for section in permit.sections %}
      <!-- Section {{ forloop.index }}: {{ section.question }} -->
      <div class="card" style="margin-bottom: 2rem; border-left: 4px solid {{ forloop.index0 | getSectionBorderColor: section.question }};">
        <h2>{{ section.question }}</h2>
        {{ section.content }}
      </div>
      {% endfor %}

    </div>
  </section>

  {% if permit.primoDocuments.size > 0 %}
  <!-- SECTION: FIRST ISSUE -->
  <section id="primo" class="section bg-off-white">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">📋 First Issue</h2>

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign primoMethodLower = permit.primoMethod | downcase -%}
      {%- if primoMethodLower contains 'kit' -%}
        {%- assign primoCalloutClass = 'callout-kit' -%}
        {%- assign primoCalloutIcon = '📮' -%}
        {%- assign primoCalloutText = 'Submit via postal KIT (no Police visit needed)' -%}
      {%- else -%}
        {%- assign primoCalloutClass = 'callout-questura' -%}
        {%- assign primoCalloutIcon = '🏛️' -%}
        {%- assign primoCalloutText = 'Bring documents to the Police Headquarters (you cannot use the postal KIT)' -%}
      {%- endif -%}
      <div class="submission-callout {{ primoCalloutClass }}" style="margin-bottom: 1.5rem;">
        <span class="callout-icon">{{ primoCalloutIcon }}</span>
        <div class="callout-text">{{ primoCalloutText }}</div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 Required documents</h3>
        <p class="checklist-intro">Check off the documents you've already prepared. Your progress is saved automatically.</p>

        <div class="doc-checklist" data-permit="{{ permit.slug }}-primo-en">
          {%- for docItem in permit.primoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign docClass = normalizedDoc | getDocumentClass -%}
            {%- assign docLabel = normalizedDoc | linkToDizionario: lang -%}
            {%- assign disputed = normalizedDoc | isDisputed -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-primo-en-{{ forloop.index0 }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(may vary by Police office)</span>{% endif %}</span>
          </div>
          {%- endfor -%}
        </div>

        <div class="checklist-progress">
          <span class="progress-text">Completed: <span id="primo-progress-count">0</span>/{{ permit.primoDocuments.size }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="primo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Note:</strong> Required documents may vary from one Police office to another.
        </div>
      </div>

      {%- assign notesSections = permit.docNotes | parseDocNotes -%}
      {%- if notesSections.size > 0 -%}
      <div style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">📝 Additional document information</h3>
        {%- for section in notesSections -%}
        <div class="card" style="margin-bottom: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
          {{ section.content }}
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if permit.costBollettinoPrimo or permit.costMarcaBolloPrimo -%}
      <div id="primo-quanto-costa" style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 How much does it cost?</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoPrimo -%}
            <li class="costi-item">
              <span class="costi-label">Postal payment slip <span class="costi-note">to pay at the Post Office</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoPrimo }}{% if permit.costBollettinoAltPrimo %} or € {{ permit.costBollettinoAltPrimo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltPrimo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">Depends on the permit duration</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloPrimo -%}
            <li class="costi-item">
              <span class="costi-label">Revenue stamp <span class="costi-note">to buy at a tobacco shop</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloPrimo }}</span>
            </li>
            {%- endif -%}
            {%- if primoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Postal kit <span class="costi-note">to buy at the Post Office</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">Total</span>
            <span class="costi-total-amount">€
              {%- assign primoTotal = 0 -%}
              {%- if permit.costBollettinoPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costBollettinoPrimo -%}{%- endif -%}
              {%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}
              {%- if primoMethodLower contains 'kit' -%}{%- assign primoTotal = primoTotal | plus: 30 -%}{%- endif -%}
              {{ primoTotal }}{%- if permit.costBollettinoAltPrimo -%}{%- assign primoTotalMax = 0 -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costBollettinoAltPrimo -%}{%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}{%- if primoMethodLower contains 'kit' -%}{%- assign primoTotalMax = primoTotalMax | plus: 30 -%}{%- endif -%} – {{ primoTotalMax }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {% endif %}

  {% if permit.rinnovoDocuments.size > 0 %}
  <!-- SECTION: RENEWAL -->
  <section id="rinnovo" class="section">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">🔄 Renewal</h2>

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign rinnovoMethodLower = permit.rinnovoMethod | downcase -%}
      {%- if rinnovoMethodLower contains 'kit' -%}
        {%- assign rinnovoCalloutClass = 'callout-kit' -%}
        {%- assign rinnovoCalloutIcon = '📮' -%}
        {%- assign rinnovoCalloutText = 'Submit via postal KIT (no Police visit needed)' -%}
      {%- else -%}
        {%- assign rinnovoCalloutClass = 'callout-questura' -%}
        {%- assign rinnovoCalloutIcon = '🏛️' -%}
        {%- assign rinnovoCalloutText = 'Bring documents to the Police Headquarters (you cannot use the postal KIT)' -%}
      {%- endif -%}
      <div class="submission-callout {{ rinnovoCalloutClass }}" style="margin-bottom: 1rem;">
        <span class="callout-icon">{{ rinnovoCalloutIcon }}</span>
        <div class="callout-text">{{ rinnovoCalloutText }}</div>
      </div>

      {%- if permit.slug contains 'attesa-occupazione' -%}
      <div class="alert alert-danger" style="background: #FFF0F0; border: 1.5px solid #E53935; border-radius: 8px; margin-bottom: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Warning:</strong> The renewal of the job-seeking permit is contested. Some Police offices deny it. We recommend consulting a lawyer or legal aid centre before proceeding.
          <br><br>
          <a href="/en/aiuto-legale.html" style="color: #E53935; font-weight: 600;">→ Find legal help in your area</a>
        </div>
      </div>
      {%- endif -%}

      <!-- REMEMBER ALERT -->
      <div class="alert alert-info" style="margin-bottom: 1rem;">
        <span class="alert-icon">📅</span>
        <div>
          <strong>Remember:</strong> The renewal application should be submitted preferably <strong>before expiry</strong> or at most <strong>within 60 days</strong> of expiry.
        </div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 Required documents</h3>
        <p class="checklist-intro">Check off the documents you've already prepared. Your progress is saved automatically.</p>

        {%- assign commonDocName = "Copia permesso precedente (o denuncia smarrimento)" -%}
        {%- assign commonDocNormalized = commonDocName | normalizeDocumentName -%}
        {%- assign commonDocClass = commonDocNormalized | getDocumentClass -%}
        {%- assign commonDocLabel = commonDocNormalized | linkToDizionario: lang -%}

        <div class="doc-checklist" data-permit="{{ permit.slug }}-rinnovo-en">
          <!-- Common document always first -->
          <div class="{{ commonDocClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-rinnovo-en-0"
                   data-doc="{{ commonDocNormalized | escapeHtml }}">
            <span class="doc-label">{{ commonDocLabel }}</span>
          </div>

          {%- for docItem in permit.rinnovoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign lowerDoc = normalizedDoc | downcase -%}
            {%- unless lowerDoc contains "copia permesso precedente" -%}
              {%- assign docClass = normalizedDoc | getDocumentClass -%}
              {%- assign docLabel = normalizedDoc | linkToDizionario: lang -%}
              {%- assign disputed = normalizedDoc | isDisputed -%}
              {%- assign idx = forloop.index -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-rinnovo-en-{{ idx }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(may vary by Police office)</span>{% endif %}</span>
          </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

        {%- assign rinnovoTotalDocs = permit.rinnovoDocuments.size | plus: 1 -%}
        <div class="checklist-progress">
          <span class="progress-text">Completed: <span id="rinnovo-progress-count">0</span>/{{ rinnovoTotalDocs }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="rinnovo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Note:</strong> Required documents may vary from one Police office to another.
        </div>
      </div>

      {%- if permit.primoDocuments.size == 0 -%}
        {%- assign rinnovoNotesSections = permit.docNotes | parseDocNotes -%}
        {%- if rinnovoNotesSections.size > 0 -%}
        <div style="margin-top: 1.5rem;">
          <h3 style="text-align: center; margin-bottom: 1rem;">📝 Additional document information</h3>
          {%- for section in rinnovoNotesSections -%}
          <div class="card" style="margin-bottom: 1rem;">
            <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
            {{ section.content }}
          </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      {%- endif -%}

      {%- if permit.costBollettinoRinnovo or permit.costMarcaBolloRinnovo -%}
      <div id="rinnovo-quanto-costa" style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 How much does renewal cost?</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoRinnovo -%}
            <li class="costi-item">
              <span class="costi-label">Postal payment slip <span class="costi-note">to pay at the Post Office</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoRinnovo }}{% if permit.costBollettinoAltRinnovo %} or € {{ permit.costBollettinoAltRinnovo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltRinnovo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">Depends on the permit duration</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloRinnovo -%}
            <li class="costi-item">
              <span class="costi-label">Revenue stamp <span class="costi-note">to buy at a tobacco shop</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloRinnovo }}</span>
            </li>
            {%- endif -%}
            {%- if rinnovoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Postal kit <span class="costi-note">to buy at the Post Office</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">Total</span>
            <span class="costi-total-amount">€
              {%- assign rinnovoTotal = 0 -%}
              {%- if permit.costBollettinoRinnovo -%}{%- assign rinnovoTotal = rinnovoTotal | plus: permit.costBollettinoRinnovo -%}{%- endif -%}
              {%- if permit.costMarcaBolloRinnovo -%}{%- assign rinnovoTotal = rinnovoTotal | plus: permit.costMarcaBolloRinnovo -%}{%- endif -%}
              {%- if rinnovoMethodLower contains 'kit' -%}{%- assign rinnovoTotal = rinnovoTotal | plus: 30 -%}{%- endif -%}
              {{ rinnovoTotal }}{%- if permit.costBollettinoAltRinnovo -%}{%- assign rinnovoTotalMax = 0 -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: permit.costBollettinoAltRinnovo -%}{%- if permit.costMarcaBolloRinnovo -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: permit.costMarcaBolloRinnovo -%}{%- endif -%}{%- if rinnovoMethodLower contains 'kit' -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: 30 -%}{%- endif -%} – {{ rinnovoTotalMax }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {% endif %}

  <!-- PRASSI LOCALI ACCORDION -->
  <section class="section prassi-section bg-off-white" id="prassi-locali">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 0.5rem;">📍 Local practices</h2>
      <p style="text-align: center; color: var(--gray-medium); margin-bottom: 1rem; font-size: 0.9rem;">Experiences shared by the community about Police office practices</p>

      {% assign pagePrassi = prassiLocali[permit.slug] %}
      {% if pagePrassi %}
        <div class="prassi-accordion">
          {% for cityGroup in pagePrassi %}
            <div class="prassi-accordion-item">
              <button class="prassi-accordion-header" aria-expanded="false" onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); this.nextElementSibling.classList.toggle('prassi-accordion-open');">
                <span class="prassi-accordion-city">{{ cityGroup[0] }}</span>
                <span class="prassi-accordion-count">{{ cityGroup[1].size }}</span>
                <span class="prassi-accordion-chevron">▸</span>
              </button>
              <div class="prassi-accordion-body">
                {% for practice in cityGroup[1] %}
                  <div class="prassi-card" data-prassi-id="{{ practice.id }}">
                    <p class="prassi-card-description">{{ practice.description }}</p>
                    <div class="prassi-card-meta">
                      {% if practice.date %}<span>{{ practice.date }}</span>{% endif %}
                      {% if practice.category %}<span class="prassi-category-tag">{{ practice.category }}</span>{% endif %}
                    </div>
                    <div class="prassi-card-votes">
                      <span class="vote-confermo">I confirm: {{ practice.votiConfermo }}</span>
                      <span class="vote-non-confermo">I do not confirm: {{ practice.votiNonConfermo }}</span>
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>

        <div style="text-align: center; margin-top: 1rem;">
          <button class="btn btn-primary prassi-submit-btn" onclick="openPrassiModal('https://sospermesso.it/en/permesso-{{ permit.slug }}.html', '{{ permit.slug }}')">
            Add your experience
          </button>
        </div>
      {% else %}
        <div class="prassi-accordion">
          <div class="prassi-accordion-empty">
            <span style="font-size: 1.5rem;">📭</span>
            <p>No reports yet</p>
            <button class="btn btn-primary prassi-submit-btn btn-sm" onclick="openPrassiModal('https://sospermesso.it/en/permesso-{{ permit.slug }}.html', '{{ permit.slug }}')">
              Be the first to share
            </button>
          </div>
        </div>
      {% endif %}
    </div>
  </section>

  <!-- Checklist persistence -->
  <script>
    (function() {
      function initChecklist(permitKey, progressCountId, progressFillId) {
        var checkboxes = document.querySelectorAll('[data-permit="' + permitKey + '"] .doc-checkbox');
        if (!checkboxes.length) return;
        var progressCount = document.getElementById(progressCountId);
        var progressFill = document.getElementById(progressFillId);

        function updateProgress() {
          var total = checkboxes.length;
          var checked = Array.from(checkboxes).filter(function(cb) { return cb.checked; }).length;
          if (progressCount) progressCount.textContent = checked;
          if (progressFill) progressFill.style.width = (total > 0 ? (checked / total) * 100 : 0) + '%';
        }

        function loadState() {
          var saved = localStorage.getItem('checklist-' + permitKey);
          if (saved) {
            try {
              var state = JSON.parse(saved);
              state.forEach(function(item) {
                var checkbox = document.getElementById(item.id);
                if (checkbox) checkbox.checked = item.checked;
              });
            } catch (e) {
              console.warn('Failed to load checklist state:', e);
            }
          }
          updateProgress();
        }

        function saveState() {
          var state = Array.from(checkboxes).map(function(cb) {
            return { id: cb.id, checked: cb.checked };
          });
          localStorage.setItem('checklist-' + permitKey, JSON.stringify(state));
          updateProgress();
        }

        checkboxes.forEach(function(cb) { cb.addEventListener('change', saveState); });
        loadState();
      }

      document.addEventListener('DOMContentLoaded', function() {
        initChecklist('{{ permit.slug }}-primo-en', 'primo-progress-count', 'primo-progress-fill');
        initChecklist('{{ permit.slug }}-rinnovo-en', 'rinnovo-progress-count', 'rinnovo-progress-fill');
      });
    })();
  </script>
  <script src="../src/scripts/prassi.js"></script>

  <!-- CTA: DO YOU HAVE MORE QUESTIONS -->
  <section class="section">
    <div class="container" style="max-width: 700px;">
      <div class="alert alert-info">
        <span class="alert-icon">❓</span>
        <div>
          Do you have more questions about the permit for {{ permit.tipo }}?
          <a href="https://form.typeform.com/to/G6YT01Vj" target="_blank" class="btn btn-primary btn-sm" style="margin-left: 0; margin-top: 0.5rem;">
            Contact us
          </a>
        </div>
      </div>
    </div>
  </section>

{% endif %}

  <!-- SEGNALA ERRORE -->
  <div class="report-bar">
    <a href="https://form.typeform.com/to/FsqvzdXI" target="_blank" rel="noopener" class="report-btn">
      <span>🚩</span> Segnala un errore in questa pagina
