.DS_Store
.claude/
node_modules/
*.log
.env
_site/

# Local Netlify folder
.netlify

# Notion API response cache
.notion-cache/

# Translation review reports (symlink into ../translations-shared, generated locally,
# not committed — no trailing slash so the pattern matches the symlink itself)
review-reports

# Subagent translation pipeline scratch (see CLAUDE.md "Subagent translation pipeline").
# Only translate-{lang}-done.json + translate-{lang}-texts.json are kept; everything else
# is intermediate work product that translate-to-notion.js does not need after the
# Notion write succeeds.
_cache/translate-batch-*.json
_cache/translate-*-batch-*.json
_cache/translate-*-missing*.json
_cache/translate-*-remaining*.txt

# Chatbot knowledge base (generated by scripts/build-chatbot-kb.js during build)
netlify/functions/chat-kb.mjs

# data-pipeline (Python)
data-pipeline/.venv/
data-pipeline/**/__pycache__/
data-pipeline/data/*.db-shm
data-pipeline/data/*.db-wal
data-pipeline/data/classify/batch-*.json
data-pipeline/data/classify/out-*.json
