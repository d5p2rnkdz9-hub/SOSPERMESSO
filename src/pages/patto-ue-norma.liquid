---
layout: layouts/base.liquid
lang: it
pagination:
  data: pattoUe
  size: 1
  alias: regolamento
permalink: "/patto-ue-{{ regolamento.slug }}.html"
eleventyComputed:
  title: "{{ regolamento.title }} – Patto UE"
  description: "Testo integrale del {{ regolamento.regType }} (UE) {{ regolamento.regNumber }} – {{ regolamento.shortDescription }}"
extraStyles: |
  <style>
    .patto-norma-text {
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--gray-dark);
    }
    .patto-norma-text p { margin: 0.6rem 0; }
    /* Considerando paragraphs (e.g. "**(1)** text") */
    .patto-norma-text p > strong:first-child {
      display: inline-block;
      min-width: 2.5rem;
      color: var(--accent-blue);
      font-weight: 700;
      margin-right: 0.25rem;
    }
    .patto-norma-text h1,
    .patto-norma-text h2,
    .patto-norma-text h3,
    .patto-norma-text h4 {
      margin-top: 1.6rem;
      margin-bottom: 0.6rem;
      color: var(--black);
    }
    .patto-norma-text h2 { font-size: 1.4rem; }
    .patto-norma-text h3 { font-size: 1.2rem; }
    .patto-norma-text table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.6rem 0;
    }
    .patto-norma-text td {
      padding: 0.45rem 0.7rem;
      vertical-align: top;
      border-bottom: 1px solid var(--gray-light);
    }
    .patto-norma-text td:first-child {
      width: 64px;
      font-weight: 600;
      color: var(--gray-medium);
      white-space: nowrap;
    }
    .patto-norma-text ul,
    .patto-norma-text ol {
      margin: 0.5rem 0 0.6rem 1.4rem;
    }
    .patto-norma-text a { color: var(--accent-blue); }
    .patto-norma-text a:hover { text-decoration: underline; }
    .patto-norma-text sup,
    .patto-norma-text sub { font-size: 0.75em; }
    .patto-norma-text blockquote {
      margin: 0.8rem 0;
      padding: 0.4rem 1rem;
      border-left: 3px solid var(--gray-light);
      color: var(--gray-medium);
    }
    .patto-download-bar {
      position: sticky;
      top: 80px;
      background: var(--white);
      padding: 0.75rem 1rem;
      border: 1px solid var(--gray-light);
      border-radius: var(--radius-md);
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      z-index: 10;
      margin-bottom: 1.5rem;
    }
    @media (max-width: 768px) {
      .patto-download-bar { position: static; box-shadow: none; }
      .patto-norma-text { font-size: 0.92rem; }
      .patto-norma-text td:first-child { width: 50px; }
    }
  </style>
---

  <section class="section bg-off-white" style="padding-bottom: 1.5rem;">
    <div class="container">
      <nav class="breadcrumb" style="font-size: 0.9rem; color: var(--gray-medium); margin-bottom: 1rem;">
        <a href="patto-ue.html" style="color: var(--gray-medium);">Patto UE</a>
        <span style="margin: 0 0.4rem;">›</span>
        <a href="patto-ue-norme.html" style="color: var(--gray-medium);">I testi normativi</a>
        <span style="margin: 0 0.4rem;">›</span>
        <span>{{ regolamento.title }}</span>
      </nav>
      <div class="page-header text-center">
        <span class="page-icon" style="font-size: 3rem;">{{ regolamento.icon }}</span>
        <div style="font-size: 0.9rem; color: var(--gray-medium); font-weight: 600; letter-spacing: 0.05em; margin-bottom: 0.5rem;">
          {{ regolamento.regType | upcase }} (UE) {{ regolamento.regNumber }}
        </div>
        <h1 class="page-title">{{ regolamento.title }}</h1>
        <p class="section-subtitle">{{ regolamento.shortDescription }}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 1.5rem;">
    <div class="container" style="max-width: 820px;">

      <div class="patto-download-bar">
        <span style="font-weight: 600; align-self: center; margin-right: 0.25rem;">Scarica:</span>
        {% if regolamento.pdfPath %}
        <a href="{{ regolamento.pdfPath }}" class="btn btn-primary btn-sm" download>📄 PDF</a>
        {% endif %}
        <a href="{{ regolamento.mdPath }}" class="btn btn-primary btn-sm" download>📝 Testo (.md)</a>
        <a href="patto-ue-norme.html" class="btn btn-primary btn-sm" style="margin-left: auto;">← Tutti i testi</a>
      </div>

      <article class="patto-norma-text">
        {{ regolamento.mdContent | md }}
      </article>

      <div class="card" style="margin-top: 2.5rem; background: var(--gray-light);">
        <p style="margin: 0;">
          📚 Hai letto il testo della <strong>{{ regolamento.regType }} (UE) {{ regolamento.regNumber }}</strong>.
          Torna a <a href="patto-ue-norme.html"><strong>tutti i testi normativi</strong></a>
          oppure visualizza il <a href="patto-ue-diagramma.html"><strong>diagramma interattivo</strong></a>.
        </p>
      </div>

    </div>
  </section>
