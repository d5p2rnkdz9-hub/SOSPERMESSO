---
pagination:
  data: permits
  size: 1
  alias: permit
permalink: "documenti-{{ permit.slug }}-primo.html"
layout: layouts/base.liquid
lang: it
eleventyComputed:
  title: "Documenti primo rilascio — {{ permit.tipo }}"
  description: "Documenti necessari per il primo rilascio del permesso per {{ permit.tipo }}"
eleventyExcludeFromCollections: true
---

{% if permit.primoDocuments.size > 0 %}

  <!-- PAGE HEADER -->
  <section class="section bg-off-white" style="padding: 1.5rem 0;">
    <div class="container">
      <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
        <span style="font-size: 2.5rem;">{{ permit.emoji }}</span>
        <div style="text-align: center;">
          <h1 class="page-title" style="font-family: 'Poppins', sans-serif; font-weight: 800; margin-bottom: 0.25rem;">Primo rilascio</h1>
          <p style="color: var(--gray-medium); margin: 0; font-size: 0.95rem;">Permesso per {{ permit.tipo }}</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 0.75rem;">
        <a href="permesso-{{ permit.slug }}.html" style="color: var(--accent-blue); font-size: 0.9rem;">← Vedi tutte le info su questo permesso</a>
      </div>
    </div>
  </section>

  <!-- DOCUMENT SECTION -->
  <section class="section">
    <div class="container" style="max-width: 700px;">

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign primoMethodLower = permit.primoMethod | downcase -%}
      {%- if primoMethodLower contains 'kit' -%}
        {%- assign primoCalloutClass = 'callout-kit' -%}
        {%- assign primoCalloutIcon = '📮' -%}
        {%- assign primoCalloutText = 'Invia tramite KIT alle Poste (non devi andare in Questura)' -%}
      {%- else -%}
        {%- assign primoCalloutClass = 'callout-questura' -%}
        {%- assign primoCalloutIcon = '🏛️' -%}
        {%- assign primoCalloutText = 'Porta i documenti in Questura (non puoi usare il KIT postale)' -%}
      {%- endif -%}
      <div class="submission-callout {{ primoCalloutClass }}" style="margin-bottom: 1.5rem;">
        <span class="callout-icon">{{ primoCalloutIcon }}</span>
        <div class="callout-text">{{ primoCalloutText }}</div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 Documenti necessari</h3>
        <p class="checklist-intro">Spunta i documenti che hai già preparato. I tuoi progressi vengono salvati automaticamente.</p>

        <div class="doc-checklist" data-permit="{{ permit.slug }}-primo">
          {%- for docItem in permit.primoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign docClass = normalizedDoc | getDocumentClass -%}
            {%- assign docLabel = normalizedDoc | linkToDizionario: lang -%}
            {%- assign disputed = normalizedDoc | isDisputed -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-primo-{{ forloop.index0 }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(potrebbe dipendere dalla Questura)</span>{% endif %}</span>
          </div>
          {%- endfor -%}
        </div>

        <div class="checklist-progress">
          <span class="progress-text">Completati: <span id="primo-progress-count">0</span>/{{ permit.primoDocuments.size }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="primo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Nota:</strong> I documenti richiesti possono variare da Questura a Questura. <a href="permesso-{{ permit.slug }}.html#prassi-locali">Vedi le prassi locali →</a>
        </div>
      </div>

      {%- assign notesSections = permit.docNotes | parseDocNotes -%}
      {%- if notesSections.size > 0 -%}
      <div style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">📝 Informazioni aggiuntive sui documenti</h3>
        {%- for section in notesSections -%}
        <div class="card" style="margin-bottom: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
          {{ section.content }}
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if permit.costBollettinoPrimo or permit.costMarcaBolloPrimo -%}
      <div style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 Quanto costa?</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoPrimo -%}
            <li class="costi-item">
              <span class="costi-label">Bollettino postale <span class="costi-note">da pagare alle Poste</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoPrimo }}{% if permit.costBollettinoAltPrimo %} o € {{ permit.costBollettinoAltPrimo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltPrimo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">Dipende dalla durata del permesso</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloPrimo -%}
            <li class="costi-item">
              <span class="costi-label">Marca da bollo <span class="costi-note">da comprare in tabaccheria</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloPrimo }}</span>
            </li>
            {%- endif -%}
            {%- if primoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Kit postale <span class="costi-note">da comprare alle Poste</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">Totale</span>
            <span class="costi-total-amount">€
              {%- assign primoTotal = 0 -%}
              {%- if permit.costBollettinoPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costBollettinoPrimo -%}{%- endif -%}
              {%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}
              {%- if primoMethodLower contains 'kit' -%}{%- assign primoTotal = primoTotal | plus: 30 -%}{%- endif -%}
              {{ primoTotal }}{%- if permit.costBollettinoAltPrimo -%}{%- assign primoTotalMax = 0 -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costBollettinoAltPrimo -%}{%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}{%- if primoMethodLower contains 'kit' -%}{%- assign primoTotalMax = primoTotalMax | plus: 30 -%}{%- endif -%} – {{ primoTotalMax }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}

    </div>
  </section>

  <!-- Checklist persistence -->
  <script>
    (function() {
      var checkboxes = document.querySelectorAll('[data-permit="{{ permit.slug }}-primo"] .doc-checkbox');
      if (!checkboxes.length) return;
      var progressCount = document.getElementById('primo-progress-count');
      var progressFill = document.getElementById('primo-progress-fill');
      var key = 'checklist-{{ permit.slug }}-primo';

      function updateProgress() {
        var total = checkboxes.length;
        var checked = Array.from(checkboxes).filter(function(cb) { return cb.checked; }).length;
        if (progressCount) progressCount.textContent = checked;
        if (progressFill) progressFill.style.width = (total > 0 ? (checked / total) * 100 : 0) + '%';
      }

      function loadState() {
        var saved = localStorage.getItem(key);
        if (saved) {
          try {
            JSON.parse(saved).forEach(function(item) {
              var checkbox = document.getElementById(item.id);
              if (checkbox) checkbox.checked = item.checked;
            });
          } catch (e) {}
        }
        updateProgress();
      }

      function saveState() {
        var state = Array.from(checkboxes).map(function(cb) {
          return { id: cb.id, checked: cb.checked };
        });
        localStorage.setItem(key, JSON.stringify(state));
        updateProgress();
      }

      checkboxes.forEach(function(cb) { cb.addEventListener('change', saveState); });
      loadState();
    })();
  </script>

  <!-- RELATED -->
  <section class="section bg-off-white">
    <div class="container">
      <h2 class="text-center mb-lg">Potrebbero interessarti anche</h2>
      <div class="grid grid-3">
        <a href="permesso-{{ permit.slug }}.html" class="card card-link card-compact">
          <span class="card-icon">📄</span>
          <h3 class="card-title">Info su questo permesso</h3>
        </a>
        {% if permit.rinnovoDocuments.size > 0 %}
        <a href="documenti-{{ permit.slug }}-rinnovo.html" class="card card-link card-compact">
          <span class="card-icon">🔄</span>
          <h3 class="card-title">Documenti per il rinnovo</h3>
        </a>
        {% endif %}
        <a href="documenti-questura.html" class="card card-link card-compact">
          <span class="card-icon">📋</span>
          <h3 class="card-title">Tutti i documenti</h3>
        </a>
      </div>
    </div>
  </section>

  <!-- SEGNALA ERRORE -->
  <div class="report-bar">
    <a href="https://testsospermesso.netlify.app/it/contattaci/segnala-errore" target="_blank" rel="noopener" class="report-btn">
      <span>🚩</span> Segnala un errore in questa pagina
    </a>
  </div>

{% else %}

  <!-- No primo documents for this permit — output empty page that 11ty can skip -->
  <div style="display:none;">No primo rilascio documents available for {{ permit.tipo }}</div>

{% endif %}
