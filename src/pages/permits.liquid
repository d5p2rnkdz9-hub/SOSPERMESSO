---
pagination:
  data: permits
  size: 1
  alias: permit
permalink: "permesso-{{ permit.slug }}.html"
layout: layouts/base.liquid
lang: it
eleventyComputed:
  title: "Permesso di soggiorno per {{ permit.tipo }} | SOS Permesso"
  description: "Permesso di soggiorno per {{ permit.tipo }}: requisiti, chi può richiederlo, documenti necessari, durata, costi e come fare domanda. Guida chiara e aggiornata."
eleventyExcludeFromCollections: true
---

  <!-- Structured data: FAQPage (from Q&A sections) + BreadcrumbList -->
  {%- assign faqLd = permit | faqJsonLd -%}
  {%- if faqLd != "" %}
  <script type="application/ld+json">{{ faqLd }}</script>
  {%- endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
      { "@type": "ListItem", "position": 2, "name": "Database permessi", "item": "{{ site.url }}/database.html" },
      { "@type": "ListItem", "position": 3, "name": {{ permit.tipo | jsonString }}, "item": "{{ site.url }}/permesso-{{ permit.slug }}.html" }
    ]
  }
  </script>

  <!-- STICKY HEADER: title + tab badges -->
  <div class="permit-sticky-header" id="permit-tab-bar">
    <div class="container">
      <div class="permit-title-row">
        <span class="permit-title-emoji">{{ permit.emoji }}</span>
        <h1 class="permit-title-text">Permesso per {{ permit.tipo }}</h1>
      </div>
      {% unless permit.isPlaceholder == true %}
      {%- comment -%} Prassi shortcut lives in the documents CTA card; keep the badge only when that card doesn't render (permits with no document lists) {%- endcomment -%}
      {% if permit.primoDocuments.size == 0 and permit.rinnovoDocuments.size == 0 %}
      <div class="permit-tab-badges" style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; padding: 0.5rem 0 0.75rem;">
        <a href="#prassi-locali" class="tab-badge tab-badge-prassi" onclick="return scrollToSection('prassi-locali')">📍 Prassi locali</a>
      </div>
      {% endif %}
      {% endunless %}
    </div>
  </div>

  {% unless permit.isPlaceholder == true %}
  <script>
  // Measure actual header height for sticky positioning
  (function() {
    var h = document.querySelector('.header');
    if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
    window.addEventListener('resize', function() {
      if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
    });
  })();

  function scrollToSection(id) {
    var el = document.getElementById(id);
    if (!el) return true;
    var stickyHeader = document.getElementById('permit-tab-bar');
    var offset = 20;
    if (stickyHeader) offset += stickyHeader.getBoundingClientRect().height;
    var top = el.getBoundingClientRect().top + window.pageYOffset - offset;
    window.scrollTo({ top: top, behavior: 'smooth' });
    // Set active badge
    setActiveBadge(id);
    return false;
  }

  function setActiveBadge(id) {
    var badges = document.querySelectorAll('.tab-badge');
    badges.forEach(function(b) { b.classList.remove('active'); });
    var active = document.querySelector('.tab-badge[href="#' + id + '"]');
    if (active) active.classList.add('active');
  }

  // Track scroll position to update active badge
  (function() {
    var sections = ['cose', 'primo', 'rinnovo', 'prassi-locali'];
    var ticking = false;

    function getOffset() {
      var stickyHeader = document.getElementById('permit-tab-bar');
      var off = 40;
      if (stickyHeader) off += stickyHeader.getBoundingClientRect().height;
      return off;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        var offset = getOffset();
        var current = null;
        for (var i = sections.length - 1; i >= 0; i--) {
          var el = document.getElementById(sections[i]);
          if (el && el.getBoundingClientRect().top <= offset) {
            current = sections[i];
            break;
          }
        }
        if (current) setActiveBadge(current);
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Set initial active badge on load
    document.addEventListener('DOMContentLoaded', function() {
      onScroll();
    });
  })();
  </script>
  {% endunless %}

{% if permit.isPlaceholder == true %}
  <!-- PLACEHOLDER PAGE -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <div class="card text-center" style="padding: 3rem;">
        <span style="font-size: 4rem;">{{ permit.emoji }}</span>
        <h2 style="margin: 1rem 0;">Contenuto in arrivo</h2>
        <p style="color: var(--gray-medium); max-width: 500px; margin: 0 auto 1.5rem;">
          Stiamo ancora lavorando per completare le informazioni
          su questo permesso di soggiorno.
        </p>
        <a href="https://app.sospermesso.it/it/contattaci"
           class="btn btn-primary"
           target="_blank"
           rel="noopener noreferrer">
          Dai una mano
        </a>
      </div>
    </div>
  </section>

{% else %}

  {% if permit.primoDocuments.size > 0 or permit.rinnovoDocuments.size > 0 %}
  <!-- DOCUMENTS CTA -->
  <section class="section" style="padding: 1.5rem 0 0;">
    <div class="container" style="max-width: 700px;">
      <div class="card" style="text-align: center;">
        <h2 style="margin-bottom: 0.5rem;">Che documenti ti servono?</h2>
        <p style="color: var(--gray-medium); margin-bottom: 1rem;">Apri la scheda con la lista completa: puoi spuntarla, condividerla o stamparla.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center;">
          {% if permit.primoDocuments.size > 0 %}
          <a href="documenti-{{ permit.slug }}-primo.html" class="btn btn-primary">Prima richiesta</a>
          {% endif %}
          {% if permit.rinnovoDocuments.size > 0 %}
          <a href="documenti-{{ permit.slug }}-rinnovo.html" class="btn btn-primary">Rinnovo</a>
          {% endif %}
          <a href="#prassi-locali" class="btn btn-primary" onclick="return scrollToSection('prassi-locali')">Prassi locali</a>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {%- assign proScheda = proContent.permits[permit.slug] -%}
  {% if proScheda %}
  <!-- SECTION: SCHEDA PRO (visibile solo in Versione PRO, vedi pro.css) -->
  <section id="pro" class="section pro-only pro-section" style="padding: 1.5rem 0 0;">
    <div class="container" style="max-width: 900px;">
      <div class="pro-card">
        <div class="pro-card-head">
          <span class="pro-pill">Scheda PRO</span>
          {% if proContent.draft %}<span class="pro-pill pro-pill-outline" title="Contenuto in bozza: in attesa di validazione legale">Bozza</span>{% endif %}
          <span class="pro-updated">agg. {{ proScheda.aggiornato_al }}</span>
        </div>

        <p>{{ proScheda.sintesi.descrizione }}</p>
        <p><strong>Base giuridica:</strong> {{ proScheda.sintesi.base_giuridica }}</p>

        <div class="pro-grid">
          <div><strong>Durata</strong><br>{{ proScheda.sintesi.durata }}</div>
          <div><strong>Rinnovo</strong><br>{{ proScheda.sintesi.rinnovo }}</div>
          <div class="pro-grid-full"><strong>Convertibilità</strong><br>{{ proScheda.sintesi.convertibilita }}</div>
        </div>

        {% if proScheda.sintesi.requisiti.size > 0 %}
        <h3>Requisiti</h3>
        <ul>
          {% for r in proScheda.sintesi.requisiti %}<li>{{ r }}</li>{% endfor %}
        </ul>
        {% endif %}

        {% if proScheda.sintesi.note_operative.size > 0 %}
        <div class="pro-note">
          <h3>Note operative</h3>
          <ul>
            {% for n in proScheda.sintesi.note_operative %}<li>{{ n }}</li>{% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if proScheda.norme.size > 0 %}
        <h3>Norme di riferimento</h3>
        <ul class="pro-refs">
          {% for n in proScheda.norme %}
          <li>
            {% if n.url %}<a href="{{ n.url }}" target="_blank" rel="noopener noreferrer">{{ n.fonte }}, {{ n.estremi }}</a>{% else %}<strong>{{ n.fonte }}, {{ n.estremi }}</strong>{% endif %}
            — {{ n.oggetto }}
          </li>
          {% endfor %}
        </ul>
        {% endif %}

        {% if proScheda.sentenze.size > 0 %}
        <h3>⚖️ Giurisprudenza essenziale</h3>
        <div class="pro-sentenze">
          {% for s in proScheda.sentenze %}
          <div class="pro-sentenza">
            <p class="pro-sentenza-head"><strong>{{ s.corte }}, {{ s.estremi }}</strong><span>{{ s.data }}</span></p>
            <p class="pro-sentenza-massima">{{ s.massima | slice: 0, 140 }}{% if s.massima.size > 140 %}<span class="pro-blur" aria-hidden="true">{{ s.massima | slice: 140, 400 }}</span>{% endif %}</p>
            <button type="button" class="pro-lock-btn" disabled title="Disponibile con l'abbonamento PRO (in arrivo)">🔒 Massima integrale e rilevanza operativa — PRO</button>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        {% if proScheda.circolari.size > 0 %}
        <h3>Circolari chiave</h3>
        <ul class="pro-refs">
          {% for c in proScheda.circolari %}
          <li><strong>{{ c.ente }} {{ c.estremi }}</strong>{% if c.data and c.data != '' %} ({{ c.data }}){% endif %} — {{ c.oggetto }}{% if c.url %} <a href="{{ c.url }}" target="_blank" rel="noopener noreferrer">testo</a>{% endif %}</li>
          {% endfor %}
        </ul>
        {% endif %}

        {%- assign circCount = 0 -%}
        {%- capture circolariCollegate -%}
        {%- for c in circolariDb -%}
          {%- if circCount < 5 -%}
            {%- for pc in c.permessi -%}
              {%- if pc.slug == permit.slug -%}
                <li><a href="{{ c.slug }}.html">{{ c.ente }}{% if c.numero %} n. {{ c.numero }}{% endif %}{% if c.data %} del {{ c.data }}{% endif %}</a> — {{ c.oggetto | truncate: 120 }}</li>
                {%- assign circCount = circCount | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        {%- endcapture -%}
        {% if circolariCollegate != '' %}
        <h3>📄 Circolari collegate a questo permesso</h3>
        <ul class="pro-refs">{{ circolariCollegate }}</ul>
        <p><a href="circolari-db.html">Cerca tra tutte le circolari →</a></p>
        {% endif %}

        <p class="pro-disclaimer">Contenuti informativi per operatori professionali, non consulenza legale.{% if proContent.draft %} Bozza in corso di validazione: verificare sempre i riferimenti prima dell'uso in pratica.{% endif %}</p>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- SECTION: COS'È -->
  <section id="cose" class="section">
    <div class="container" style="max-width: 900px;">
      {% for section in permit.sections %}
      <!-- Section {{ forloop.index }}: {{ section.question }} -->
      <div class="card" style="margin-bottom: 2rem; border-left: 4px solid {{ forloop.index0 | getSectionBorderColor: section.question }};">
        <h2>{{ section.question }}</h2>
        {{ section.content }}
      </div>
      {% endfor %}

    </div>
  </section>

  {% if permit.primoDocuments.size > 0 %}
  <!-- SECTION: PRIMO RILASCIO -->
  <section id="primo" class="section bg-off-white">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">📋 Primo rilascio</h2>

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign primoMethodLower = permit.primoMethod | downcase -%}
      {%- if primoMethodLower contains 'kit' -%}
        {%- assign primoCalloutClass = 'callout-kit' -%}
        {%- assign primoCalloutIcon = '📮' -%}
        {%- assign primoCalloutText = 'Invia tramite KIT alle Poste (non devi andare in Questura)' -%}
      {%- else -%}
        {%- assign primoCalloutClass = 'callout-questura' -%}
        {%- assign primoCalloutIcon = '🏛️' -%}
        {%- assign primoCalloutText = 'Porta i documenti in Questura (non puoi usare il KIT postale)' -%}
      {%- endif -%}
      <div class="submission-callout {{ primoCalloutClass }}" style="margin-bottom: 1.5rem;">
        <span class="callout-icon">{{ primoCalloutIcon }}</span>
        <div class="callout-text">{{ primoCalloutText }}</div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 Documenti necessari</h3>
        <p class="checklist-intro">Spunta i documenti che hai già preparato. I tuoi progressi vengono salvati automaticamente.</p>

        <div class="doc-checklist" data-permit="{{ permit.slug }}-primo">
          {%- for docItem in permit.primoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign docClass = normalizedDoc | getDocumentClass -%}
            {%- assign docLabel = normalizedDoc | linkToDizionario: lang -%}
            {%- assign disputed = normalizedDoc | isDisputed -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-primo-{{ forloop.index0 }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(potrebbe dipendere dalla Questura)</span>{% endif %}</span>
          </div>
          {%- endfor -%}
        </div>

        <div class="checklist-progress">
          <span class="progress-text">Completati: <span id="primo-progress-count">0</span>/{{ permit.primoDocuments.size }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="primo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Nota:</strong> I documenti richiesti possono variare da Questura a Questura. Vedi se ci sono info specifiche nella sezione 'Prassi locali'.
        </div>
      </div>

      {%- assign notesSections = permit.docNotes | parseDocNotes -%}
      {%- if notesSections.size > 0 -%}
      <div style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">📝 Informazioni aggiuntive sui documenti</h3>
        {%- for section in notesSections -%}
        <div class="card" style="margin-bottom: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
          {{ section.content }}
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if permit.costBollettinoPrimo or permit.costMarcaBolloPrimo -%}
      <div id="primo-quanto-costa" style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 Quanto costa?</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoPrimo -%}
            <li class="costi-item">
              <span class="costi-label">Bollettino postale <span class="costi-note">da pagare alle Poste</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoPrimo }}{% if permit.costBollettinoAltPrimo %} o € {{ permit.costBollettinoAltPrimo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltPrimo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">Dipende dalla durata del permesso</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloPrimo -%}
            <li class="costi-item">
              <span class="costi-label">Marca da bollo <span class="costi-note">da comprare in tabaccheria</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloPrimo }}</span>
            </li>
            {%- endif -%}
            {%- if primoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Kit postale <span class="costi-note">da comprare alle Poste</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">Totale</span>
            <span class="costi-total-amount">€
              {%- assign primoTotal = 0 -%}
              {%- if permit.costBollettinoPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costBollettinoPrimo -%}{%- endif -%}
              {%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}
              {%- if primoMethodLower contains 'kit' -%}{%- assign primoTotal = primoTotal | plus: 30 -%}{%- endif -%}
              {{ primoTotal | round: 2 }}{%- if permit.costBollettinoAltPrimo -%}{%- assign primoTotalMax = 0 -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costBollettinoAltPrimo -%}{%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}{%- if primoMethodLower contains 'kit' -%}{%- assign primoTotalMax = primoTotalMax | plus: 30 -%}{%- endif -%} – {{ primoTotalMax | round: 2 }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {% endif %}

  {% if permit.rinnovoDocuments.size > 0 %}
  <!-- SECTION: RINNOVO -->
  <section id="rinnovo" class="section">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">🔄 Rinnovo</h2>

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign rinnovoMethodLower = permit.rinnovoMethod | downcase -%}
      {%- if rinnovoMethodLower contains 'kit' -%}
        {%- assign rinnovoCalloutClass = 'callout-kit' -%}
        {%- assign rinnovoCalloutIcon = '📮' -%}
        {%- assign rinnovoCalloutText = 'Invia tramite KIT alle Poste (non devi andare in Questura)' -%}
      {%- else -%}
        {%- assign rinnovoCalloutClass = 'callout-questura' -%}
        {%- assign rinnovoCalloutIcon = '🏛️' -%}
        {%- assign rinnovoCalloutText = 'Porta i documenti in Questura (non puoi usare il KIT postale)' -%}
      {%- endif -%}
      <div class="submission-callout {{ rinnovoCalloutClass }}" style="margin-bottom: 1rem;">
        <span class="callout-icon">{{ rinnovoCalloutIcon }}</span>
        <div class="callout-text">{{ rinnovoCalloutText }}</div>
      </div>

      {%- if permit.slug contains 'attesa-occupazione' -%}
      <!-- DISPUTED RENEWAL WARNING -->
      <div class="alert alert-danger" style="background: #FFF0F0; border: 1.5px solid #E53935; border-radius: 8px; margin-bottom: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Attenzione:</strong> Il rinnovo del permesso per attesa occupazione è controverso. Alcune Questure lo negano. Ti consigliamo di rivolgerti a un avvocato o sportello legale prima di procedere.
          <br><br>
          <a href="aiuto-legale.html" style="color: #E53935; font-weight: 600;">→ Trova aiuto legale nella tua zona</a>
        </div>
      </div>
      {%- endif -%}

      <!-- RICORDA ALERT -->
      <div class="alert alert-info" style="margin-bottom: 1rem;">
        <span class="alert-icon">📅</span>
        <div>
          <strong>Ricorda:</strong> La richiesta di rinnovo va presentata preferibilmente <strong>prima della scadenza</strong> o comunque <strong>entro 60 giorni</strong> dalla scadenza.
        </div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 Documenti necessari</h3>
        <p class="checklist-intro">Spunta i documenti che hai già preparato. I tuoi progressi vengono salvati automaticamente.</p>

        {%- assign commonDocName = "Copia permesso precedente (o denuncia smarrimento)" -%}
        {%- assign commonDocNormalized = commonDocName | normalizeDocumentName -%}
        {%- assign commonDocClass = commonDocNormalized | getDocumentClass -%}
        {%- assign commonDocLabel = commonDocNormalized | linkToDizionario: lang -%}

        <div class="doc-checklist" data-permit="{{ permit.slug }}-rinnovo">
          <!-- Common document always first -->
          <div class="{{ commonDocClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-rinnovo-0"
                   data-doc="{{ commonDocNormalized | escapeHtml }}">
            <span class="doc-label">{{ commonDocLabel }}</span>
          </div>

          {%- for docItem in permit.rinnovoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign lowerDoc = normalizedDoc | downcase -%}
            {%- unless lowerDoc contains "copia permesso precedente" -%}
              {%- assign docClass = normalizedDoc | getDocumentClass -%}
              {%- assign docLabel = normalizedDoc | linkToDizionario: lang -%}
              {%- assign disputed = normalizedDoc | isDisputed -%}
              {%- assign idx = forloop.index -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-rinnovo-{{ idx }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(potrebbe dipendere dalla Questura)</span>{% endif %}</span>
          </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

        {%- assign rinnovoTotalDocs = permit.rinnovoDocuments.size | plus: 1 -%}
        <div class="checklist-progress">
          <span class="progress-text">Completati: <span id="rinnovo-progress-count">0</span>/{{ rinnovoTotalDocs }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="rinnovo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Nota:</strong> I documenti richiesti possono variare da Questura a Questura. Vedi se ci sono info specifiche nella sezione 'Prassi locali'.
        </div>
      </div>

      {%- if permit.primoDocuments.size == 0 -%}
        {%- assign rinnovoNotesSections = permit.docNotes | parseDocNotes -%}
        {%- if rinnovoNotesSections.size > 0 -%}
        <div style="margin-top: 1.5rem;">
          <h3 style="text-align: center; margin-bottom: 1rem;">📝 Informazioni aggiuntive sui documenti</h3>
          {%- for section in rinnovoNotesSections -%}
          <div class="card" style="margin-bottom: 1rem;">
            <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
            {{ section.content }}
          </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      {%- endif -%}

      {%- if permit.costBollettinoRinnovo or permit.costMarcaBolloRinnovo -%}
      <div id="rinnovo-quanto-costa" style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 Quanto costa il rinnovo?</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoRinnovo -%}
            <li class="costi-item">
              <span class="costi-label">Bollettino postale <span class="costi-note">da pagare alle Poste</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoRinnovo }}{% if permit.costBollettinoAltRinnovo %} o € {{ permit.costBollettinoAltRinnovo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltRinnovo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">Dipende dalla durata del permesso</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloRinnovo -%}
            <li class="costi-item">
              <span class="costi-label">Marca da bollo <span class="costi-note">da comprare in tabaccheria</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloRinnovo }}</span>
            </li>
            {%- endif -%}
            {%- if rinnovoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Kit postale <span class="costi-note">da comprare alle Poste</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">Totale</span>
            <span class="costi-total-amount">€
              {%- assign rinnovoTotal = 0 -%}
              {%- if permit.costBollettinoRinnovo -%}{%- assign rinnovoTotal = rinnovoTotal | plus: permit.costBollettinoRinnovo -%}{%- endif -%}
              {%- if permit.costMarcaBolloRinnovo -%}{%- assign rinnovoTotal = rinnovoTotal | plus: permit.costMarcaBolloRinnovo -%}{%- endif -%}
              {%- if rinnovoMethodLower contains 'kit' -%}{%- assign rinnovoTotal = rinnovoTotal | plus: 30 -%}{%- endif -%}
              {{ rinnovoTotal | round: 2 }}{%- if permit.costBollettinoAltRinnovo -%}{%- assign rinnovoTotalMax = 0 -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: permit.costBollettinoAltRinnovo -%}{%- if permit.costMarcaBolloRinnovo -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: permit.costMarcaBolloRinnovo -%}{%- endif -%}{%- if rinnovoMethodLower contains 'kit' -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: 30 -%}{%- endif -%} – {{ rinnovoTotalMax | round: 2 }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {% endif %}

  <!-- PRASSI LOCALI ACCORDION -->
  <section class="section prassi-section bg-off-white" id="prassi-locali">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 0.5rem;">📍 Prassi locali</h2>
      <p style="text-align: center; color: var(--gray-medium); margin-bottom: 1rem; font-size: 0.9rem;">Esperienze condivise dalla community sulle pratiche delle Questure</p>

