---
pagination:
  data: permitsUr
  size: 1
  alias: permit
permalink: "ur/permesso-{{ permit.slug }}.html"
layout: layouts/base.liquid
lang: ur
eleventyComputed:
  title: "{{ permit.tipo }} - رہائشی اجازت نامہ"
  description: "{{ permit.tipo }} - رہائشی اجازت نامے کے بارے میں معلومات، شرائط، دستاویزات اور طریقہ کار"
eleventyExcludeFromCollections: true
---

  <!-- STICKY HEADER: title + tab badges -->
  <div class="permit-sticky-header" id="permit-tab-bar">
    <div class="container">
      <div class="permit-title-row">
        <span class="permit-title-emoji">{{ permit.emoji }}</span>
        <h1 class="permit-title-text">{{ permit.tipo }}</h1>
      </div>
      {% unless permit.isPlaceholder == true %}
      <div class="permit-tab-badges" style="display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; padding: 0.5rem 0 0.75rem;">
        <a href="#cose" class="tab-badge" onclick="return scrollToSection('cose')">معلومات</a>
        {% if permit.primoDocuments.size > 0 %}
        <a href="#primo" class="tab-badge tab-badge-primo" onclick="return scrollToSection('primo')">Doc پہلی بار جاری</a>
        {% endif %}
        {% if permit.rinnovoDocuments.size > 0 %}
        <a href="#rinnovo" class="tab-badge tab-badge-rinnovo" onclick="return scrollToSection('rinnovo')">Doc تجدید</a>
        {% endif %}
        <a href="#prassi-locali" class="tab-badge tab-badge-prassi" onclick="return scrollToSection('prassi-locali')">📍 مقامی طریقے</a>
      </div>
      {% endunless %}
    </div>
  </div>

  {% unless permit.isPlaceholder == true %}
  <script>
  // Measure actual header height for sticky positioning
  (function() {
    var h = document.querySelector('.header');
    if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
    window.addEventListener('resize', function() {
      if (h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
    });
  })();

  function scrollToSection(id) {
    var el = document.getElementById(id);
    if (!el) return true;
    var stickyHeader = document.getElementById('permit-tab-bar');
    var offset = 20;
    if (stickyHeader) offset += stickyHeader.getBoundingClientRect().height;
    var top = el.getBoundingClientRect().top + window.pageYOffset - offset;
    window.scrollTo({ top: top, behavior: 'smooth' });
    setActiveBadge(id);
    return false;
  }

  function setActiveBadge(id) {
    var badges = document.querySelectorAll('.tab-badge');
    badges.forEach(function(b) { b.classList.remove('active'); });
    var active = document.querySelector('.tab-badge[href="#' + id + '"]');
    if (active) active.classList.add('active');
  }

  // Track scroll position to update active badge
  (function() {
    var sections = ['cose', 'primo', 'rinnovo', 'prassi-locali'];
    var ticking = false;

    function getOffset() {
      var stickyHeader = document.getElementById('permit-tab-bar');
      var off = 40;
      if (stickyHeader) off += stickyHeader.getBoundingClientRect().height;
      return off;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        var offset = getOffset();
        var current = null;
        for (var i = sections.length - 1; i >= 0; i--) {
          var el = document.getElementById(sections[i]);
          if (el && el.getBoundingClientRect().top <= offset) {
            current = sections[i];
            break;
          }
        }
        if (current) setActiveBadge(current);
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    // Set initial active badge on load
    document.addEventListener('DOMContentLoaded', function() {
      onScroll();
    });
  })();
  </script>
  {% endunless %}

{% if permit.isPlaceholder == true %}
  <!-- PLACEHOLDER PAGE -->
  <section class="section">
    <div class="container" style="max-width: 900px;">
      <div class="card text-center" style="padding: 3rem;">
        <span style="font-size: 4rem;">{{ permit.emoji }}</span>
        <h2 style="margin: 1rem 0;">مواد جلد آ رہا ہے</h2>
        <p style="color: var(--gray-medium); max-width: 500px; margin: 0 auto 1.5rem;">
          ہم اس رہائشی اجازت نامے کے بارے میں معلومات مکمل کرنے پر کام کر رہے ہیں۔
        </p>
        <a href="https://app.sospermesso.it/it/contattaci"
           class="btn btn-primary"
           target="_blank"
           rel="noopener noreferrer">
          ہماری مدد کریں
        </a>
      </div>
    </div>
  </section>

{% else %}

  <!-- SECTION: INFO -->
  <section id="cose" class="section">
    <div class="container" style="max-width: 900px;">
      {% for section in permit.sections %}
      <!-- Section {{ forloop.index }}: {{ section.question }} -->
      <div class="card" style="margin-bottom: 2rem; border-right: 4px solid {{ forloop.index0 | getSectionBorderColor: section.question }}; border-left: none;">
        <h2>{{ section.question }}</h2>
        {{ section.content }}
      </div>
      {% endfor %}

    </div>
  </section>

  {% if permit.primoDocuments.size > 0 %}
  <!-- SECTION: FIRST ISSUANCE -->
  <section id="primo" class="section bg-off-white">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">📋 پہلی بار جاری</h2>

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign primoMethodLower = permit.primoMethod | downcase -%}
      {%- if primoMethodLower contains 'kit' -%}
        {%- assign primoCalloutClass = 'callout-kit' -%}
        {%- assign primoCalloutIcon = '📮' -%}
        {%- assign primoCalloutText = 'Kit Postale کے ذریعے بھیجیں (Questura جانے کی ضرورت نہیں)' -%}
      {%- else -%}
        {%- assign primoCalloutClass = 'callout-questura' -%}
        {%- assign primoCalloutIcon = '🏛️' -%}
        {%- assign primoCalloutText = 'Questura میں دستاویزات جمع کرائیں (Kit Postale استعمال نہیں ہو سکتا)' -%}
      {%- endif -%}
      <div class="submission-callout {{ primoCalloutClass }}" style="margin-bottom: 1.5rem;">
        <span class="callout-icon">{{ primoCalloutIcon }}</span>
        <div class="callout-text">{{ primoCalloutText }}</div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 مطلوبہ دستاویزات</h3>
        <p class="checklist-intro">جو دستاویزات آپ نے تیار کر لی ہیں ان پر نشان لگائیں۔ آپ کی پیشرفت خودکار طور پر محفوظ ہو جاتی ہے۔</p>

        <div class="doc-checklist" data-permit="{{ permit.slug }}-primo-ur">
          {%- for docItem in permit.primoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign docClass = normalizedDoc | getDocumentClass -%}
            {%- assign docLabel = normalizedDoc | escapeHtml -%}
            {%- assign disputed = normalizedDoc | isDisputed -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-primo-ur-{{ forloop.index0 }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(Questura کے مطابق مختلف ہو سکتا ہے)</span>{% endif %}</span>
          </div>
          {%- endfor -%}
        </div>

        <div class="checklist-progress">
          <span class="progress-text">مکمل: <span id="primo-progress-count">0</span>/{{ permit.primoDocuments.size }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="primo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>نوٹ:</strong> مطلوبہ دستاویزات ایک Questura سے دوسرے میں مختلف ہو سکتی ہیں۔
        </div>
      </div>

      {%- assign notesSections = permit.docNotes | parseDocNotes -%}
      {%- if notesSections.size > 0 -%}
      <div style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">📝 دستاویزات کے بارے میں اضافی معلومات</h3>
        {%- for section in notesSections -%}
        <div class="card" style="margin-bottom: 1rem;">
          <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
          {{ section.content }}
        </div>
        {%- endfor -%}
      </div>
      {%- endif -%}

      {%- if permit.costBollettinoPrimo or permit.costMarcaBolloPrimo -%}
      <div id="primo-quanto-costa" style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 اخراجات کتنے ہیں؟</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoPrimo -%}
            <li class="costi-item">
              <span class="costi-label">بولتینو پوسٹل <span class="costi-note">ڈاک خانے میں ادا کریں</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoPrimo }}{% if permit.costBollettinoAltPrimo %} یا € {{ permit.costBollettinoAltPrimo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltPrimo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">اجازت نامے کی مدت پر منحصر ہے</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloPrimo -%}
            <li class="costi-item">
              <span class="costi-label">مارکا دا بولو <span class="costi-note">تمباکو کی دکان سے خریدیں</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloPrimo }}</span>
            </li>
            {%- endif -%}
            {%- if primoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Kit Postale <span class="costi-note">ڈاک خانے سے خریدیں</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">کل رقم</span>
            <span class="costi-total-amount">€
              {%- assign primoTotal = 0 -%}
              {%- if permit.costBollettinoPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costBollettinoPrimo -%}{%- endif -%}
              {%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotal = primoTotal | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}
              {%- if primoMethodLower contains 'kit' -%}{%- assign primoTotal = primoTotal | plus: 30 -%}{%- endif -%}
              {{ primoTotal | round: 2 }}{%- if permit.costBollettinoAltPrimo -%}{%- assign primoTotalMax = 0 -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costBollettinoAltPrimo -%}{%- if permit.costMarcaBolloPrimo -%}{%- assign primoTotalMax = primoTotalMax | plus: permit.costMarcaBolloPrimo -%}{%- endif -%}{%- if primoMethodLower contains 'kit' -%}{%- assign primoTotalMax = primoTotalMax | plus: 30 -%}{%- endif -%} – {{ primoTotalMax | round: 2 }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {% endif %}

  {% if permit.rinnovoDocuments.size > 0 %}
  <!-- SECTION: RENEWAL -->
  <section id="rinnovo" class="section">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">🔄 تجدید</h2>

      <!-- SUBMISSION METHOD CALLOUT -->
      {%- assign rinnovoMethodLower = permit.rinnovoMethod | downcase -%}
      {%- if rinnovoMethodLower contains 'kit' -%}
        {%- assign rinnovoCalloutClass = 'callout-kit' -%}
        {%- assign rinnovoCalloutIcon = '📮' -%}
        {%- assign rinnovoCalloutText = 'Kit Postale کے ذریعے بھیجیں (Questura جانے کی ضرورت نہیں)' -%}
      {%- else -%}
        {%- assign rinnovoCalloutClass = 'callout-questura' -%}
        {%- assign rinnovoCalloutIcon = '🏛️' -%}
        {%- assign rinnovoCalloutText = 'Questura میں دستاویزات جمع کرائیں (Kit Postale استعمال نہیں ہو سکتا)' -%}
      {%- endif -%}
      <div class="submission-callout {{ rinnovoCalloutClass }}" style="margin-bottom: 1rem;">
        <span class="callout-icon">{{ rinnovoCalloutIcon }}</span>
        <div class="callout-text">{{ rinnovoCalloutText }}</div>
      </div>

      {%- if permit.slug contains 'attesa-occupazione' -%}
      <!-- DISPUTED RENEWAL WARNING -->
      <div class="alert alert-danger" style="background: #FFF0F0; border: 1.5px solid #E53935; border-radius: 8px; margin-bottom: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>خبردار:</strong> ملازمت کے انتظار کے اجازت نامے کی تجدید ایک متنازعہ معاملہ ہے۔ کچھ Questura اسے مسترد کر دیتے ہیں۔ ہم مشورہ دیتے ہیں کہ کارروائی شروع کرنے سے پہلے کسی وکیل یا قانونی مدد کے مرکز سے مشورہ کریں۔
          <br><br>
          <a href="/ur/aiuto-legale.html" style="color: #E53935; font-weight: 600;">← اپنے علاقے میں قانونی مدد تلاش کریں</a>
        </div>
      </div>
      {%- endif -%}

      <!-- REMINDER ALERT -->
      <div class="alert alert-info" style="margin-bottom: 1rem;">
        <span class="alert-icon">📅</span>
        <div>
          <strong>یاد رکھیں:</strong> تجدید کی درخواست <strong>میعاد ختم ہونے سے پہلے</strong> دینی چاہیے یا میعاد ختم ہونے کے بعد زیادہ سے زیادہ <strong>60 دن</strong> کے اندر۔
        </div>
      </div>

      <!-- CHECKLIST -->
      <div class="card">
        <h3>📋 مطلوبہ دستاویزات</h3>
        <p class="checklist-intro">جو دستاویزات آپ نے تیار کر لی ہیں ان پر نشان لگائیں۔ آپ کی پیشرفت خودکار طور پر محفوظ ہو جاتی ہے۔</p>

        {%- assign commonDocName = "Copia permesso precedente (o denuncia smarrimento)" -%}
        {%- assign commonDocNormalized = commonDocName | normalizeDocumentName -%}
        {%- assign commonDocClass = commonDocNormalized | getDocumentClass -%}
        {%- assign commonDocLabel = commonDocNormalized | escapeHtml -%}

        <div class="doc-checklist" data-permit="{{ permit.slug }}-rinnovo-ur">
          <!-- Common document always first -->
          <div class="{{ commonDocClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-rinnovo-ur-0"
                   data-doc="{{ commonDocNormalized | escapeHtml }}">
            <span class="doc-label">{{ commonDocLabel }}</span>
          </div>

          {%- for docItem in permit.rinnovoDocuments -%}
            {%- assign normalizedDoc = docItem | normalizeDocumentName -%}
            {%- assign lowerDoc = normalizedDoc | downcase -%}
            {%- unless lowerDoc contains "copia permesso precedente" -%}
              {%- assign docClass = normalizedDoc | getDocumentClass -%}
              {%- assign docLabel = normalizedDoc | escapeHtml -%}
              {%- assign disputed = normalizedDoc | isDisputed -%}
              {%- assign idx = forloop.index -%}
          <div class="{{ docClass }}">
            <input type="checkbox"
                   class="doc-checkbox"
                   id="doc-{{ permit.slug }}-rinnovo-ur-{{ idx }}"
                   data-doc="{{ normalizedDoc | escapeHtml }}">
            <span class="doc-label">{{ docLabel }}{% if disputed %}<span class="disputed-note">(Questura کے مطابق مختلف ہو سکتا ہے)</span>{% endif %}</span>
          </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

        {%- assign rinnovoTotalDocs = permit.rinnovoDocuments.size | plus: 1 -%}
        <div class="checklist-progress">
          <span class="progress-text">مکمل: <span id="rinnovo-progress-count">0</span>/{{ rinnovoTotalDocs }}</span>
          <div class="progress-bar">
            <div class="progress-fill" id="rinnovo-progress-fill" style="width: 0%"></div>
          </div>
        </div>
      </div>

      <div class="alert alert-warning" style="margin-top: 1rem;">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>نوٹ:</strong> مطلوبہ دستاویزات ایک Questura سے دوسرے میں مختلف ہو سکتی ہیں۔
        </div>
      </div>

      {%- if permit.primoDocuments.size == 0 -%}
        {%- assign rinnovoNotesSections = permit.docNotes | parseDocNotes -%}
        {%- if rinnovoNotesSections.size > 0 -%}
        <div style="margin-top: 1.5rem;">
          <h3 style="text-align: center; margin-bottom: 1rem;">📝 دستاویزات کے بارے میں اضافی معلومات</h3>
          {%- for section in rinnovoNotesSections -%}
          <div class="card" style="margin-bottom: 1rem;">
            <h4 style="margin-bottom: 0.75rem; font-size: 1rem;">{{ section.question | escapeHtml }}</h4>
            {{ section.content }}
          </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      {%- endif -%}

      {%- if permit.costBollettinoRinnovo or permit.costMarcaBolloRinnovo -%}
      <div id="rinnovo-quanto-costa" style="margin-top: 1.5rem;">
        <h3 style="text-align: center; margin-bottom: 1rem;">💰 تجدید کے اخراجات کتنے ہیں؟</h3>
        <div class="card">
          <ul class="costi-list">
            {%- if permit.costBollettinoRinnovo -%}
            <li class="costi-item">
              <span class="costi-label">بولتینو پوسٹل <span class="costi-note">ڈاک خانے میں ادا کریں</span></span>
              <span class="costi-amount">€ {{ permit.costBollettinoRinnovo }}{% if permit.costBollettinoAltRinnovo %} یا € {{ permit.costBollettinoAltRinnovo }}{% endif %}</span>
            </li>
            {%- if permit.costBollettinoAltRinnovo -%}
            <li style="font-size: 0.85rem; color: var(--gray-medium); list-style: none; margin-top: -0.25rem;">اجازت نامے کی مدت پر منحصر ہے</li>
            {%- endif -%}
            {%- endif -%}
            {%- if permit.costMarcaBolloRinnovo -%}
            <li class="costi-item">
              <span class="costi-label">مارکا دا بولو <span class="costi-note">تمباکو کی دکان سے خریدیں</span></span>
              <span class="costi-amount">€ {{ permit.costMarcaBolloRinnovo }}</span>
            </li>
            {%- endif -%}
            {%- if rinnovoMethodLower contains 'kit' -%}
            <li class="costi-item">
              <span class="costi-label">Kit Postale <span class="costi-note">ڈاک خانے سے خریدیں</span></span>
              <span class="costi-amount">€ 30,00</span>
            </li>
            {%- endif -%}
          </ul>
          <div class="costi-total">
            <span class="costi-total-label">کل رقم</span>
            <span class="costi-total-amount">€
              {%- assign rinnovoTotal = 0 -%}
              {%- if permit.costBollettinoRinnovo -%}{%- assign rinnovoTotal = rinnovoTotal | plus: permit.costBollettinoRinnovo -%}{%- endif -%}
              {%- if permit.costMarcaBolloRinnovo -%}{%- assign rinnovoTotal = rinnovoTotal | plus: permit.costMarcaBolloRinnovo -%}{%- endif -%}
              {%- if rinnovoMethodLower contains 'kit' -%}{%- assign rinnovoTotal = rinnovoTotal | plus: 30 -%}{%- endif -%}
              {{ rinnovoTotal | round: 2 }}{%- if permit.costBollettinoAltRinnovo -%}{%- assign rinnovoTotalMax = 0 -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: permit.costBollettinoAltRinnovo -%}{%- if permit.costMarcaBolloRinnovo -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: permit.costMarcaBolloRinnovo -%}{%- endif -%}{%- if rinnovoMethodLower contains 'kit' -%}{%- assign rinnovoTotalMax = rinnovoTotalMax | plus: 30 -%}{%- endif -%} – {{ rinnovoTotalMax | round: 2 }}{%- endif -%}
            </span>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </section>
  {% endif %}

  <!-- PRASSI LOCALI ACCORDION -->
  <section class="section prassi-section bg-off-white" id="prassi-locali">
    <div class="container" style="max-width: 700px;">
      <h2 style="text-align: center; margin-bottom: 0.5rem;">📍 مقامی طریقے</h2>
      <p style="text-align: center; color: var(--gray-medium); margin-bottom: 1rem; font-size: 0.9rem;">Questura کے طریقوں کے بارے میں کمیونٹی کے تجربات</p>

      {% assign pagePrassi = prassiLocali[permit.slug] %}
      {% if pagePrassi %}
        <div class="prassi-accordion">
          {% for cityGroup in pagePrassi %}
            <div class="prassi-accordion-item">
              <button class="prassi-accordion-header" aria-expanded="false" onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); this.nextElementSibling.classList.toggle('prassi-accordion-open');">
                <span class="prassi-accordion-city">{{ cityGroup[0] }}</span>
                <span class="prassi-accordion-count">{{ cityGroup[1].size }}</span>
                <span class="prassi-accordion-chevron">◂</span>
              </button>
              <div class="prassi-accordion-body">
                {% for practice in cityGroup[1] %}
                  <div class="prassi-card" data-prassi-id="{{ practice.id }}">
                    <p class="prassi-card-description">{{ practice.description }}</p>
                    <div class="prassi-card-meta">
                      {% if practice.date %}<span>{{ practice.date }}</span>{% endif %}
                      {% if practice.category %}<span class="prassi-category-tag">{{ practice.category }}</span>{% endif %}
                    </div>
                    <div class="prassi-card-votes">
                      <span class="vote-confermo">تصدیق: {{ practice.votiConfermo }}</span>
