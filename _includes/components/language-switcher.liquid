<!-- Language Switcher Component (mobile-only; styles inline so they ship with the
     markup and can't fall out of sync with a cached components.css) -->
<style>
  /* Hidden by default (desktop uses the language item inside the nav menu) */
  .language-switcher { display: none; position: relative; }
  /* Dropdown is closed by default everywhere; only an .open switcher reveals it */
  .language-dropdown { display: none; }
  .language-switcher.open .language-dropdown { display: block; }

  @media (max-width: 768px) {
    .language-switcher {
      display: inline-flex !important;
      order: 2;
      margin-inline-start: auto;
      margin-inline-end: 0.5rem;
    }
    .language-button {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.375rem 0.625rem;
      font-size: 0.8rem;
      font-weight: 600;
      background: transparent;
      color: var(--black);
      border: 1.5px solid rgba(0, 0, 0, 0.15);
      border-radius: 8px;
      cursor: pointer;
      white-space: nowrap;
    }
    .language-button:active { background: var(--gray-light); }
    .language-dropdown {
      position: absolute;
      top: calc(100% + 0.4rem);
      inset-inline-end: 0;
      min-width: 11rem;
      max-height: 70vh;
      overflow-y: auto;
      background: var(--white);
      border: 1.5px solid rgba(0, 0, 0, 0.12);
      border-radius: 12px;
      box-shadow: var(--shadow-lg);
      padding: 0.35rem;
      z-index: 1060;
    }
    .language-option {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 0.75rem;
      border-radius: 8px;
      font-size: 0.95rem;
      color: var(--black);
      cursor: pointer;
    }
    .language-option:active,
    .language-option.active-lang { background: var(--gray-light); }
  }
</style>
<div class="language-switcher">
  <button class="language-button" id="language-toggle">
    {% if lang == 'fr' %}
    <span id="current-language">FR 🇫🇷</span>
    {% elsif lang == 'en' %}
    <span id="current-language">EN 🇬🇧</span>
    {% elsif lang == 'es' %}
    <span id="current-language">ES 🇪🇸</span>
    {% elsif lang == 'tr' %}
    <span id="current-language">TR 🇹🇷</span>
    {% elsif lang == 'bn' %}
    <span id="current-language">BN 🇧🇩</span>
    {% elsif lang == 'ru' %}
    <span id="current-language">RU 🇷🇺</span>
    {% elsif lang == 'ar' %}
    <span id="current-language">AR 🇸🇦</span>
    {% elsif lang == 'ur' %}
    <span id="current-language">UR 🇵🇰</span>
    {% elsif lang == 'fa' %}
    <span id="current-language">FA 🇮🇷/🇦🇫</span>
    {% elsif lang == 'zh' %}
    <span id="current-language">ZH 🇨🇳</span>
    {% else %}
    <span id="current-language">IT 🇮🇹</span>
    {% endif %}
    <span>▾</span>
  </button>
  <div class="language-dropdown" id="language-dropdown">
    <div class="language-option" data-lang="it">
      <span>🇮🇹</span>
      <span>Italiano</span>
    </div>
    <div class="language-option" data-lang="en">
      <span>🇬🇧</span>
      <span>English</span>
    </div>
    <div class="language-option" data-lang="fr">
      <span>🇫🇷</span>
      <span>Français</span>
    </div>
    <div class="language-option" data-lang="es">
      <span>🇪🇸</span>
      <span>Español</span>
    </div>
    <div class="language-option" data-lang="tr">
      <span>🇹🇷</span>
      <span>Türkçe</span>
    </div>
    <div class="language-option" data-lang="bn">
      <span>🇧🇩</span>
      <span>বাংলা</span>
    </div>
    <div class="language-option" data-lang="ru">
      <span>🇷🇺</span>
      <span>Русский</span>
    </div>
    <div class="language-option" data-lang="ar">
      <span>🇸🇦</span>
      <span>العربية</span>
    </div>
    <div class="language-option" data-lang="ur">
      <span>🇵🇰</span>
      <span>اردو</span>
    </div>
    <div class="language-option" data-lang="fa">
      <span>🇮🇷/🇦🇫</span>
      <span>فارسی</span>
    </div>
    <div class="language-option" data-lang="zh">
      <span>🇨🇳</span>
      <span>中文</span>
    </div>
  </div>
</div>
