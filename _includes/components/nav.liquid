<!-- Navigation Component -->
<div class="nav-wrapper">
  <ul class="nav-menu" id="nav-menu">
    <!-- Language Switcher as first nav item -->
    {%- assign urlPrefix = page.url | slice: 0, 4 -%}
    {%- if urlPrefix == "/en/" -%}
      {%- assign langItUrl = page.url | replace_first: "/en/", "/" -%}
      {%- assign langEnUrl = page.url -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
    {%- elsif urlPrefix == "/fr/" -%}
      {%- assign langItUrl = page.url | replace_first: "/fr/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = page.url -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
    {%- elsif urlPrefix == "/es/" -%}
      {%- assign langItUrl = page.url | replace_first: "/es/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = page.url -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
    {%- elsif urlPrefix == "/tr/" -%}
      {%- assign langItUrl = page.url | replace_first: "/tr/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = page.url -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
    {%- elsif urlPrefix == "/bn/" -%}
      {%- assign langItUrl = page.url | replace_first: "/bn/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = page.url -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
    {%- elsif urlPrefix == "/ru/" -%}
      {%- assign langItUrl = page.url | replace_first: "/ru/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = page.url -%}
    {%- else -%}
      {%- assign langItUrl = page.url -%}
      {%- assign langEnUrl = "/en" | append: page.url -%}
      {%- assign langFrUrl = "/fr" | append: page.url -%}
      {%- assign langEsUrl = "/es" | append: page.url -%}
      {%- assign langTrUrl = "/tr" | append: page.url -%}
      {%- assign langBnUrl = "/bn" | append: page.url -%}
      {%- assign langRuUrl = "/ru" | append: page.url -%}
    {%- endif -%}
    <li class="nav-item has-dropdown nav-language">
      <a href="#" class="nav-link" aria-haspopup="true" aria-expanded="false">
        {% if lang == 'fr' %}🇫🇷 FR{% elsif lang == 'en' %}🇬🇧 EN{% elsif lang == 'es' %}🇪🇸 ES{% elsif lang == 'tr' %}🇹🇷 TR{% elsif lang == 'bn' %}🇧🇩 BN{% elsif lang == 'ru' %}🇷🇺 RU{% else %}🇮🇹 IT{% endif %}
      </a>
      <ul class="nav-dropdown" role="menu">
        <li role="none"><a href="{{ langItUrl }}" class="dropdown-link{% if lang == 'it' %} active-lang{% endif %}" role="menuitem">🇮🇹 Italiano</a></li>
        <li role="none"><a href="{{ langEnUrl }}" class="dropdown-link{% if lang == 'en' %} active-lang{% endif %}" role="menuitem">🇬🇧 English</a></li>
        <li role="none"><a href="{{ langFrUrl }}" class="dropdown-link{% if lang == 'fr' %} active-lang{% endif %}" role="menuitem">🇫🇷 Français</a></li>
        <li role="none"><a href="{{ langEsUrl }}" class="dropdown-link{% if lang == 'es' %} active-lang{% endif %}" role="menuitem">🇪🇸 Español</a></li>
        <li role="none"><a href="{{ langTrUrl }}" class="dropdown-link{% if lang == 'tr' %} active-lang{% endif %}" role="menuitem">🇹🇷 Türkçe</a></li>
        <li role="none"><a href="{{ langBnUrl }}" class="dropdown-link{% if lang == 'bn' %} active-lang{% endif %}" role="menuitem">🇧🇩 বাংলা</a></li>
        <li role="none"><a href="{{ langRuUrl }}" class="dropdown-link{% if lang == 'ru' %} active-lang{% endif %}" role="menuitem">🇷🇺 Русский</a></li>
      </ul>
    </li>
    {% assign navData = nav[lang] | default: nav.it %}
    {% for dropdown in navData.dropdowns %}
    {% if dropdown.items.size > 0 %}
    <li class="nav-item has-dropdown">
      <a href="{% if dropdown.external %}{{ dropdown.href }}{% else %}{{ dropdown.href | url }}{% endif %}" class="nav-link" aria-haspopup="true" aria-expanded="false"{% if dropdown.external %} target="_blank"{% endif %}>{{ dropdown.label }}</a>
      <ul class="nav-dropdown" role="menu">
        {% for item in dropdown.items %}
        <li role="none">
          <a href="{% if item.external %}{{ item.href }}{% else %}{{ item.href | url }}{% endif %}" class="dropdown-link" role="menuitem"{% if item.external %} target="_blank"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </li>
    {% else %}
    <li class="nav-item">
      <a href="{% if dropdown.external %}{{ dropdown.href }}{% else %}{{ dropdown.href | url }}{% endif %}" class="nav-link"{% if dropdown.external %} target="_blank"{% endif %}>{{ dropdown.label }}</a>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</div>
