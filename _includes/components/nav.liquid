<!-- Navigation Component -->
<div class="nav-wrapper">
  <ul class="nav-menu" id="nav-menu">
    {% assign navData = nav[lang] | default: nav.it %}
    {% for dropdown in navData.dropdowns %}
    {% if dropdown.items.size > 0 %}
    <li class="nav-item has-dropdown">
      <a href="{% if dropdown.external %}{{ dropdown.href }}{% else %}{{ dropdown.href | url }}{% endif %}" class="nav-link" aria-haspopup="true" aria-expanded="false"{% if dropdown.external %} target="_blank"{% endif %}>{{ dropdown.label }}{% if dropdown.badge %} <span class="nav-badge">{{ dropdown.badge }}</span>{% endif %}</a>
      <ul class="nav-dropdown" role="menu">
        {% for item in dropdown.items %}
        <li role="none">
          <a href="{% if item.external %}{{ item.href }}{% else %}{{ item.href | url }}{% endif %}" class="dropdown-link" role="menuitem"{% if item.external %} target="_blank"{% endif %}>{{ item.label }}{% if item.badge %} <span class="nav-badge">{{ item.badge }}</span>{% endif %}</a>
        </li>
        {% endfor %}
      </ul>
    </li>
    {% else %}
    <li class="nav-item">
      <a href="{% if dropdown.external %}{{ dropdown.href }}{% else %}{{ dropdown.href | url }}{% endif %}" class="nav-link"{% if dropdown.external %} target="_blank"{% endif %}>{{ dropdown.label }}{% if dropdown.badge %} <span class="nav-badge">{{ dropdown.badge }}</span>{% endif %}</a>
    </li>
    {% endif %}
    {% endfor %}
    <!-- Language Switcher as last nav item -->
    {%- assign urlPrefix = page.url | slice: 0, 4 -%}
    {%- if urlPrefix == "/en/" -%}
      {%- assign langItUrl = page.url | replace_first: "/en/", "/" -%}
      {%- assign langEnUrl = page.url -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/fr/" -%}
      {%- assign langItUrl = page.url | replace_first: "/fr/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = page.url -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/es/" -%}
      {%- assign langItUrl = page.url | replace_first: "/es/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = page.url -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/tr/" -%}
      {%- assign langItUrl = page.url | replace_first: "/tr/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = page.url -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/bn/" -%}
      {%- assign langItUrl = page.url | replace_first: "/bn/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = page.url -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/ru/" -%}
      {%- assign langItUrl = page.url | replace_first: "/ru/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = page.url -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/ar/" -%}
      {%- assign langItUrl = page.url | replace_first: "/ar/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = page.url -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/ur/" -%}
      {%- assign langItUrl = page.url | replace_first: "/ur/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = page.url -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/fa/" -%}
      {%- assign langItUrl = page.url | replace_first: "/fa/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = page.url -%}
      {%- assign langZhUrl = "/zh" | append: langItUrl -%}
    {%- elsif urlPrefix == "/zh/" -%}
      {%- assign langItUrl = page.url | replace_first: "/zh/", "/" -%}
      {%- assign langEnUrl = "/en" | append: langItUrl -%}
      {%- assign langFrUrl = "/fr" | append: langItUrl -%}
      {%- assign langEsUrl = "/es" | append: langItUrl -%}
      {%- assign langTrUrl = "/tr" | append: langItUrl -%}
      {%- assign langBnUrl = "/bn" | append: langItUrl -%}
      {%- assign langRuUrl = "/ru" | append: langItUrl -%}
      {%- assign langArUrl = "/ar" | append: langItUrl -%}
      {%- assign langUrUrl = "/ur" | append: langItUrl -%}
      {%- assign langFaUrl = "/fa" | append: langItUrl -%}
      {%- assign langZhUrl = page.url -%}
    {%- else -%}
      {%- assign langItUrl = page.url -%}
      {%- assign langEnUrl = "/en" | append: page.url -%}
      {%- assign langFrUrl = "/fr" | append: page.url -%}
      {%- assign langEsUrl = "/es" | append: page.url -%}
      {%- assign langTrUrl = "/tr" | append: page.url -%}
      {%- assign langBnUrl = "/bn" | append: page.url -%}
      {%- assign langRuUrl = "/ru" | append: page.url -%}
      {%- assign langArUrl = "/ar" | append: page.url -%}
      {%- assign langUrUrl = "/ur" | append: page.url -%}
      {%- assign langFaUrl = "/fa" | append: page.url -%}
      {%- assign langZhUrl = "/zh" | append: page.url -%}
    {%- endif -%}
    {%- comment -%} Pages without translated counterparts: send those languages
        to langSwitchPath instead of a nonexistent mirrored URL. Languages
        listed in langSwitchAvailable keep the normal link. {%- endcomment -%}
    {%- if langSwitchPath -%}
      {%- assign lsAvail = langSwitchAvailable | default: "" -%}
      {%- unless lsAvail contains "en" -%}{%- assign langEnUrl = "/en" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "fr" -%}{%- assign langFrUrl = "/fr" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "es" -%}{%- assign langEsUrl = "/es" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "tr" -%}{%- assign langTrUrl = "/tr" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "bn" -%}{%- assign langBnUrl = "/bn" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "ru" -%}{%- assign langRuUrl = "/ru" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "ar" -%}{%- assign langArUrl = "/ar" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "ur" -%}{%- assign langUrUrl = "/ur" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "fa" -%}{%- assign langFaUrl = "/fa" | append: langSwitchPath -%}{%- endunless -%}
      {%- unless lsAvail contains "zh" -%}{%- assign langZhUrl = "/zh" | append: langSwitchPath -%}{%- endunless -%}
    {%- endif -%}
    <li class="nav-item has-dropdown nav-language">
      <a href="#" class="nav-link" aria-haspopup="true" aria-expanded="false">
        {% if lang == 'fr' %}🇫🇷 FR{% elsif lang == 'en' %}🇬🇧 EN{% elsif lang == 'es' %}🇪🇸 ES{% elsif lang == 'tr' %}🇹🇷 TR{% elsif lang == 'bn' %}🇧🇩 BN{% elsif lang == 'ru' %}🇷🇺 RU{% elsif lang == 'ar' %}🇸🇦 AR{% elsif lang == 'ur' %}🇵🇰 UR{% elsif lang == 'fa' %}🇮🇷 FA{% elsif lang == 'zh' %}🇨🇳 ZH{% else %}🇮🇹 IT{% endif %}
      </a>
      <ul class="nav-dropdown" role="menu">
        <li role="none"><a href="{{ langItUrl }}" class="dropdown-link{% if lang == 'it' %} active-lang{% endif %}" role="menuitem">🇮🇹 <span class="lang-code">IT</span><span class="lang-name"> Italiano</span></a></li>
        <li role="none"><a href="{{ langEnUrl }}" class="dropdown-link{% if lang == 'en' %} active-lang{% endif %}" role="menuitem">🇬🇧 <span class="lang-code">EN</span><span class="lang-name"> English</span></a></li>
        <li role="none"><a href="{{ langFrUrl }}" class="dropdown-link{% if lang == 'fr' %} active-lang{% endif %}" role="menuitem">🇫🇷 <span class="lang-code">FR</span><span class="lang-name"> Français</span></a></li>
        <li role="none"><a href="{{ langEsUrl }}" class="dropdown-link{% if lang == 'es' %} active-lang{% endif %}" role="menuitem">🇪🇸 <span class="lang-code">ES</span><span class="lang-name"> Español</span></a></li>
        <li role="none"><a href="{{ langTrUrl }}" class="dropdown-link{% if lang == 'tr' %} active-lang{% endif %}" role="menuitem">🇹🇷 <span class="lang-code">TR</span><span class="lang-name"> Türkçe</span></a></li>
        <li role="none"><a href="{{ langBnUrl }}" class="dropdown-link{% if lang == 'bn' %} active-lang{% endif %}" role="menuitem">🇧🇩 <span class="lang-code">BN</span><span class="lang-name"> বাংলা</span></a></li>
        <li role="none"><a href="{{ langRuUrl }}" class="dropdown-link{% if lang == 'ru' %} active-lang{% endif %}" role="menuitem">🇷🇺 <span class="lang-code">RU</span><span class="lang-name"> Русский</span></a></li>
        <li role="none"><a href="{{ langArUrl }}" class="dropdown-link{% if lang == 'ar' %} active-lang{% endif %}" role="menuitem">🇸🇦 <span class="lang-code">AR</span><span class="lang-name"> العربية</span></a></li>
        <li role="none"><a href="{{ langUrUrl }}" class="dropdown-link{% if lang == 'ur' %} active-lang{% endif %}" role="menuitem">🇵🇰 <span class="lang-code">UR</span><span class="lang-name"> اردو</span></a></li>
        <li role="none"><a href="{{ langFaUrl }}" class="dropdown-link{% if lang == 'fa' %} active-lang{% endif %}" role="menuitem">🇮🇷/🇦🇫 <span class="lang-code">FA</span><span class="lang-name"> فارسی</span></a></li>
        <li role="none"><a href="{{ langZhUrl }}" class="dropdown-link{% if lang == 'zh' %} active-lang{% endif %}" role="menuitem">🇨🇳 <span class="lang-code">ZH</span><span class="lang-name"> 中文</span></a></li>
      </ul>
    </li>
  </ul>
</div>
