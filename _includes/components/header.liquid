<!-- Header Component -->
<header class="header">
  <div class="container">
    <nav class="navbar">
      <!-- Logo -->
      <a href="{% if lang == 'fr' %}{{ '/fr/' | url }}{% elsif lang == 'en' %}{{ '/en/' | url }}{% elsif lang == 'es' %}{{ '/es/' | url }}{% elsif lang == 'tr' %}{{ '/tr/' | url }}{% elsif lang == 'bn' %}{{ '/bn/' | url }}{% elsif lang == 'ru' %}{{ '/ru/' | url }}{% else %}{{ '/' | url }}{% endif %}" class="logo">
        <picture>
          <source srcset="{{ '/IMAGES/logo-full.webp' | url }}" type="image/webp">
          <img src="{{ '/IMAGES/logo-full-600.png' | url }}" alt="SOS Permesso" class="logo-image" width="600" height="400" fetchpriority="high" decoding="async">
        </picture>
      </a>

      {%- comment -%} Versione PRO toggle (operatori) — NASCOSTO per ora: la
          Versione PRO è ancora in bozza, non va esposta al pubblico. Per
          rimetterla basta togliere questo commento; il resto della macchina PRO
          (script pre-paint in base.liquid, pro.css, initProToggle in app.js che
          esce da solo se il bottone non c'è, cookie sos_mode condiviso con
          app.sospermesso.it) è rimasto intatto. {%- endcomment -%}
      {%- comment -%}
      <button type="button" id="pro-toggle" class="pro-toggle" aria-pressed="false"
              aria-label="Attiva o disattiva la versione PRO per operatori"
              title="Versione PRO per operatori (CAF, patronati, sportelli)">PRO</button>
      {%- endcomment -%}

      <!-- Mobile language switcher (visible on mobile only, before hamburger) -->
      {% include "components/language-switcher.liquid" %}

      <!-- Mobile Menu Toggle -->
      <button class="menu-toggle" id="menu-toggle" aria-label="Menu">
        ☰
      </button>

      <!-- Navigation Menu -->
      {% include "components/nav.liquid" %}
    </nav>
  </div>
</header>
