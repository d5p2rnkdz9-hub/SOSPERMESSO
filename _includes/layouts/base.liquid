<!DOCTYPE html>
<html lang="{{ lang | default: 'it' }}" dir="{% if lang == 'ar' or lang == 'he' or lang == 'ur' or lang == 'fa' %}rtl{% else %}ltr{% endif %}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description | default: site.defaultDescription }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <title>{{ title | default: site.name }}</title>

  <!-- Favicon (v3 cache-bust) -->
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/IMAGES/favicon-32x32.png' | url }}?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/IMAGES/favicon-16x16.png' | url }}?v=3">
  <link rel="shortcut icon" type="image/png" href="{{ '/IMAGES/favicon-32x32.png' | url }}?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/IMAGES/apple-touch-icon.png' | url }}?v=3">

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title | default: site.name }}">
  <meta property="og:description" content="{{ description | default: site.defaultDescription }}">
  <meta property="og:image" content="{{ site.url }}/IMAGES/og-image.png">
  <meta property="og:image:secure_url" content="{{ site.url }}/IMAGES/og-image.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="SOS Permesso - Guida ai permessi di soggiorno in Italia">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default: site.name }}">
  <meta name="twitter:description" content="{{ description | default: site.defaultDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/IMAGES/og-image.png">

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- hreflang for multilingual SEO -->
  {%- assign urlPrefix = page.url | slice: 0, 4 -%}
  {%- if urlPrefix == "/en/" -%}
    {%- assign itUrl = page.url | replace_first: "/en/", "/" -%}
    {%- assign enUrl = page.url -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/fr/" -%}
    {%- assign itUrl = page.url | replace_first: "/fr/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = page.url -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/es/" -%}
    {%- assign itUrl = page.url | replace_first: "/es/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = page.url -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/tr/" -%}
    {%- assign itUrl = page.url | replace_first: "/tr/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = page.url -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/bn/" -%}
    {%- assign itUrl = page.url | replace_first: "/bn/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = page.url -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/ru/" -%}
    {%- assign itUrl = page.url | replace_first: "/ru/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = page.url -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/ar/" -%}
    {%- assign itUrl = page.url | replace_first: "/ar/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = page.url -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/ur/" -%}
    {%- assign itUrl = page.url | replace_first: "/ur/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = page.url -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/fa/" -%}
    {%- assign itUrl = page.url | replace_first: "/fa/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = page.url -%}
    {%- assign zhUrl = "/zh" | append: itUrl -%}
  {%- elsif urlPrefix == "/zh/" -%}
    {%- assign itUrl = page.url | replace_first: "/zh/", "/" -%}
    {%- assign enUrl = "/en" | append: itUrl -%}
    {%- assign frUrl = "/fr" | append: itUrl -%}
    {%- assign esUrl = "/es" | append: itUrl -%}
    {%- assign trUrl = "/tr" | append: itUrl -%}
    {%- assign bnUrl = "/bn" | append: itUrl -%}
    {%- assign ruUrl = "/ru" | append: itUrl -%}
    {%- assign arUrl = "/ar" | append: itUrl -%}
    {%- assign urUrl = "/ur" | append: itUrl -%}
    {%- assign faUrl = "/fa" | append: itUrl -%}
    {%- assign zhUrl = page.url -%}
  {%- else -%}
    {%- assign itUrl = page.url -%}
    {%- assign enUrl = "/en" | append: page.url -%}
    {%- assign frUrl = "/fr" | append: page.url -%}
    {%- assign esUrl = "/es" | append: page.url -%}
    {%- assign trUrl = "/tr" | append: page.url -%}
    {%- assign bnUrl = "/bn" | append: page.url -%}
    {%- assign ruUrl = "/ru" | append: page.url -%}
    {%- assign arUrl = "/ar" | append: page.url -%}
    {%- assign urUrl = "/ur" | append: page.url -%}
    {%- assign faUrl = "/fa" | append: page.url -%}
    {%- assign zhUrl = "/zh" | append: page.url -%}
  {%- endif -%}
  {%- if langSwitchPath -%}
  {%- comment -%} Page has no translated counterpart in some/all languages:
      only emit hreflang for versions that actually exist
      (it + langSwitchAvailable + x-default). {%- endcomment -%}
  {%- assign lsAvail = langSwitchAvailable | default: "" %}
  <link rel="alternate" hreflang="it" href="{{ site.url }}{{ itUrl }}">
  {%- if lsAvail contains "en" %}
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
  {%- endif %}
  {%- if lsAvail contains "fr" %}
  <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ frUrl }}">
  {%- endif %}
  {%- if lsAvail contains "es" %}
  <link rel="alternate" hreflang="es" href="{{ site.url }}{{ esUrl }}">
  {%- endif %}
  {%- if lsAvail contains "tr" %}
  <link rel="alternate" hreflang="tr" href="{{ site.url }}{{ trUrl }}">
  {%- endif %}
  {%- if lsAvail contains "bn" %}
  <link rel="alternate" hreflang="bn" href="{{ site.url }}{{ bnUrl }}">
  {%- endif %}
  {%- if lsAvail contains "ru" %}
  <link rel="alternate" hreflang="ru" href="{{ site.url }}{{ ruUrl }}">
  {%- endif %}
  {%- if lsAvail contains "ar" %}
  <link rel="alternate" hreflang="ar" href="{{ site.url }}{{ arUrl }}">
  {%- endif %}
  {%- if lsAvail contains "ur" %}
  <link rel="alternate" hreflang="ur" href="{{ site.url }}{{ urUrl }}">
  {%- endif %}
  {%- if lsAvail contains "fa" %}
  <link rel="alternate" hreflang="fa" href="{{ site.url }}{{ faUrl }}">
  {%- endif %}
  {%- if lsAvail contains "zh" %}
  <link rel="alternate" hreflang="zh" href="{{ site.url }}{{ zhUrl }}">
  {%- endif %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ itUrl }}">
  {%- else -%}
  <link rel="alternate" hreflang="it" href="{{ site.url }}{{ itUrl }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ enUrl }}">
  <link rel="alternate" hreflang="fr" href="{{ site.url }}{{ frUrl }}">
  <link rel="alternate" hreflang="es" href="{{ site.url }}{{ esUrl }}">
  <link rel="alternate" hreflang="tr" href="{{ site.url }}{{ trUrl }}">
  <link rel="alternate" hreflang="bn" href="{{ site.url }}{{ bnUrl }}">
  <link rel="alternate" hreflang="ru" href="{{ site.url }}{{ ruUrl }}">
  <link rel="alternate" hreflang="ar" href="{{ site.url }}{{ arUrl }}">
  <link rel="alternate" hreflang="ur" href="{{ site.url }}{{ urUrl }}">
  <link rel="alternate" hreflang="fa" href="{{ site.url }}{{ faUrl }}">
  <link rel="alternate" hreflang="zh" href="{{ site.url }}{{ zhUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ itUrl }}">
  {%- endif -%}

  <!-- Structured data: Organization + WebSite (sitewide) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ site.url }}/IMAGES/logo-full-600.png"
        },
        "description": "{{ site.defaultDescription }}"
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "inLanguage": "{{ lang | default: 'it' }}",
        "publisher": { "@id": "{{ site.url }}/#organization" }
      }
    ]
  }
  </script>

  <!-- Fonts: Latin core on every page, script-specific fonts only when needed.
       Loaded async (media="print" trick) so they never block first paint;
       metric-adjusted fallbacks in main.css make the swap shift-free. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign latinFontsUrl = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" -%}
  <link href="{{ latinFontsUrl }}" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="{{ latinFontsUrl }}" rel="stylesheet"></noscript>
  {%- assign langFontsUrl = false -%}
  {%- if lang == 'ar' or lang == 'fa' -%}
    {%- assign langFontsUrl = "https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" -%}
  {%- elsif lang == 'ur' -%}
    {%- assign langFontsUrl = "https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;500;600;700&display=swap" -%}
  {%- elsif lang == 'bn' -%}
    {%- assign langFontsUrl = "https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap" -%}
  {%- elsif lang == 'zh' -%}
    {%- assign langFontsUrl = "https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap" -%}
  {%- endif -%}
  {%- if langFontsUrl %}
  <link href="{{ langFontsUrl }}" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="{{ langFontsUrl }}" rel="stylesheet"></noscript>
  {%- endif %}

  <!-- Styles -->
  <link rel="stylesheet" href="{{ '/src/styles/main.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/components.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/animations.css' | url }}?v={{ site.assetVersion }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ '/src/styles/mobile.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/mobile-fix.css' | url }}?v={{ site.assetVersion }}">
  {%- comment -%} Script-specific CSS loads BLOCKING but only on its own language:
      loading it async on ar/ur/fa/zh/bn re-flowed the whole page (direction,
      line-height, font stacks) after first paint — a major CLS source. {%- endcomment -%}
  {%- if lang == 'ar' or lang == 'ur' or lang == 'fa' or lang == 'he' %}
  <link rel="stylesheet" href="{{ '/src/styles/rtl.css' | url }}?v={{ site.assetVersion }}">
  {%- endif %}
  {%- if lang == 'zh' %}
  <link rel="stylesheet" href="{{ '/src/styles/cjk.css' | url }}?v={{ site.assetVersion }}">
  {%- endif %}
  {%- if lang == 'bn' %}
  <link rel="stylesheet" href="{{ '/src/styles/bengali.css' | url }}?v={{ site.assetVersion }}">
  {%- endif %}
  <link rel="stylesheet" href="{{ '/src/styles/document-page.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/prassi.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/chatbot.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/circolari.css' | url }}?v={{ site.assetVersion }}">
  <link rel="stylesheet" href="{{ '/src/styles/pro.css' | url }}?v={{ site.assetVersion }}">

  <!-- Versione PRO: applicata pre-paint (localStorage con fallback sul cookie
       sos_mode condiviso con app.sospermesso.it) — nessun flash al load -->
  <script>try{var m=localStorage.getItem('sos-mode');if(!m){var c=document.cookie.match(/(?:^|; )sos_mode=([^;]*)/);m=c&&c[1]}if(m==='pro')document.documentElement.setAttribute('data-mode','pro')}catch(e){}</script>


  {% if extraStyles %}{{ extraStyles }}{% endif %}
</head>
<body>

  {% include "components/header.liquid" %}

  {% include "components/updates-banner.liquid" %}

  {{ content }}

  {% include "components/footer.liquid" %}

  <!-- Scripts -->
  <script src="{{ '/src/scripts/app.js' | url }}?v={{ site.assetVersion }}" defer></script>
  <script src="{{ '/src/scripts/mobile.js' | url }}?v={{ site.assetVersion }}" defer></script>
  <script src="{{ '/src/scripts/chatbot.js' | url }}?v={{ site.assetVersion }}" defer></script>

  {% if extraScripts %}{{ extraScripts }}{% endif %}

</body>
</html>
